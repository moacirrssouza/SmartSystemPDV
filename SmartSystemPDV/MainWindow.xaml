<Window x:Class="SystemSmartPDV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemSmartPDV"
        mc:Ignorable="d"
        Title="Smart System PDV - Sistema Principal" 
        Height="750" 
        Width="1400"
        MinHeight="650"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Storyboard para animação do menu -->
        <Storyboard x:Key="OpenMenu">
            <DoubleAnimation Storyboard.TargetName="MenuBorder"
                           Storyboard.TargetProperty="Width"
                           To="280"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <Storyboard x:Key="CloseMenu">
            <DoubleAnimation Storyboard.TargetName="MenuBorder"
                           Storyboard.TargetProperty="Width"
                           To="70"
                           Duration="0:0:0.3">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Estilo para botões do menu -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="HorizontalContentAlignment" Value="Left"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Margin="8,0">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            VerticalAlignment="Center"
                                            Margin="12,0"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2A5D8A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Cards de Atalho -->
        <Style x:Key="ShortcutCardStyle" TargetType="Border">
            <Setter Property="Width" Value="200"/>
            <Setter Property="Height" Value="160"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="RenderTransformOrigin" Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1" ScaleY="1"/>
                </Setter.Value>
            </Setter>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FCFF"/>
                    <Setter Property="BorderBrush" Value="#1A4D7A"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="#1A4D7A"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
                <EventTrigger RoutedEvent="MouseEnter">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                           To="1.05" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           To="1.05" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
                <EventTrigger RoutedEvent="MouseLeave">
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)"
                                           To="1.0" Duration="0:0:0.2"/>
                            <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)"
                                           To="1.0" Duration="0:0:0.2"/>
                        </Storyboard>
                    </BeginStoryboard>
                </EventTrigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para ícones dos cards -->
        <Style x:Key="CardIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="48"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="#1A4D7A"/>
        </Style>

        <!-- Estilo para títulos dos cards -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A4D7A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo para descrições dos cards -->
        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Menu Lateral -->
        <Border x:Name="MenuBorder"
                Grid.Column="0" 
                Width="70"
                Background="#1A4D7A"
                CornerRadius="0,12,12,0"
                Margin="0,8,0,8">
            <Border.Effect>
                <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.3" Color="#000000"/>
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="80"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Logo e botão de menu -->
                <Grid Grid.Row="0" Margin="0,12,0,0">
                    <Button x:Name="btnToggleMenu"
                            Click="BtnToggleMenu_Click"
                            Style="{StaticResource MenuButtonStyle}"
                            HorizontalAlignment="Left"
                            Width="54"
                            Height="54"
                            Margin="8,0">
                        <TextBlock Text="☰" 
                                   FontSize="24"
                                   HorizontalAlignment="Center"/>
                    </Button>

                    <StackPanel x:Name="pnlLogo"
                               Opacity="0"
                               Margin="70,0,12,0"
                               VerticalAlignment="Center">
                        <TextBlock Text="Smart PDV" 
                                   FontSize="18" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="Business Solution" 
                                   FontSize="9" 
                                   Foreground="#B8D4E8"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </Grid>

                <!-- Navegação -->
                <ScrollViewer Grid.Row="1" 
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,12,0,0">

                        <!-- Dashboard -->
                        <Button Style="{StaticResource MenuButtonStyle}">
                            <Grid>
                                <TextBlock Text="🏠" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtDashboard"
                                          Text="Dashboard"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Vendas -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnMenuVendas_Click">
                            <Grid>
                                <TextBlock Text="💰" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtVendas"
                                          Text="Vendas"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Produtos -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnMenuProdutos_Click">
                            <Grid>
                                <TextBlock Text="📦" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtProdutos"
                                          Text="Produtos"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Estoque -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnMenuEstoque_Click">
                            <Grid>
                                <TextBlock Text="📊" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtEstoque"
                                          Text="Estoque"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Clientes -->
                        <Button Style="{StaticResource MenuButtonStyle}">
                            <Grid>
                                <TextBlock Text="👨‍💼" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtClientes"
                                          Text="Clientes"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Fornecedores -->
                        <Button Style="{StaticResource MenuButtonStyle}">
                            <Grid>
                                <TextBlock Text="🏭" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtFornecedores"
                                          Text="Fornecedores"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Relatórios -->
                        <Button Style="{StaticResource MenuButtonStyle}">
                            <Grid>
                                <TextBlock Text="📈" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtRelatorios"
                                          Text="Relatórios"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Separador -->
                        <Rectangle Height="1"
                                  Fill="#2A5D8A"
                                  Margin="12,16"/>

                        <!-- Usuários -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnMenuUsuarios_Click">
                            <Grid>
                                <TextBlock Text="👥" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtUsuarios"
                                          Text="Usuários"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Permissões -->
                        <Button Style="{StaticResource MenuButtonStyle}"
                                Click="BtnMenuPermissoes_Click">
                            <Grid>
                                <TextBlock Text="🔐" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtPermissoes"
                                          Text="Permissões"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                        <!-- Configurações -->
                        <Button Style="{StaticResource MenuButtonStyle}">
                            <Grid>
                                <TextBlock Text="⚙️" 
                                          FontSize="24"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Center"/>
                                <TextBlock x:Name="txtConfiguracoes"
                                          Text="Configurações"
                                          FontSize="13"
                                          FontWeight="SemiBold"
                                          Margin="40,0,0,0"
                                          VerticalAlignment="Center"
                                          Opacity="0"/>
                            </Grid>
                        </Button>

                    </StackPanel>
                </ScrollViewer>

                <!-- Área do Usuário e Sair -->
                <StackPanel Grid.Row="2" Margin="0,0,0,12">
                    <!-- Separador -->
                    <Rectangle Height="1"
                              Fill="#2A5D8A"
                              Margin="12,0,12,12"/>

                    <!-- Usuário -->
                    <Border Background="#2A5D8A"
                            CornerRadius="8"
                            Padding="8"
                            Margin="8,0,8,8">
                        <Grid>
                            <TextBlock Text="👤" 
                                       FontSize="24"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Center"/>
                            <StackPanel x:Name="pnlUsuario"
                                       Margin="40,0,0,0"
                                       Opacity="0">
                                <TextBlock Text="Usuário"
                                          FontSize="9"
                                          Foreground="#B8D4E8"/>
                                <TextBlock x:Name="txtUsuarioLogado"
                                          Text="sa"
                                          FontSize="12"
                                          FontWeight="SemiBold"
                                          Foreground="White"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Botão Sair -->
                    <Button x:Name="btnSair"
                            Click="BtnSair_Click"
                            Background="#DC3545"
                            BorderThickness="0"
                            Height="50"
                            Cursor="Hand"
                            Margin="8,0">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="{TemplateBinding Background}"
                                        CornerRadius="8">
                                    <Grid Margin="12,0">
                                        <TextBlock Text="🚪" 
                                                   FontSize="24"
                                                   HorizontalAlignment="Left"
                                                   VerticalAlignment="Center"
                                                   Foreground="White"/>
                                        <TextBlock x:Name="txtSair"
                                                   Text="Sair"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Margin="40,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Opacity="0"/>
                                    </Grid>
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <Button.Style>
                            <Style TargetType="Button">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#C82333"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Área Principal -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Barra Superior -->
            <Border Grid.Row="0" 
                    Background="White"
                    Height="70"
                    Margin="12,8,8,0"
                    CornerRadius="12"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>

                <Grid Margin="24,0">
                    <!-- Saudação -->
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Bem-vindo ao Smart System PDV!" 
                                   FontSize="22" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"/>
                        <TextBlock Text="✓ Sistema online e operacional" 
                                   FontSize="12" 
                                   Foreground="#28A745"
                                   FontWeight="SemiBold"
                                   Margin="0,4,0,0"/>
                    </StackPanel>

                    <!-- Informações do sistema -->
                    <StackPanel Orientation="Horizontal" 
                               HorizontalAlignment="Right"
                               VerticalAlignment="Center">
                        <Border Background="#F8F9FA"
                                CornerRadius="8"
                                Padding="12,8"
                                Margin="0,0,12,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📅" 
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtDataSistema"
                                           Text="30/12/2025"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1A4D7A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>

                        <Border Background="#F8F9FA"
                                CornerRadius="8"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🕐" 
                                           FontSize="16"
                                           VerticalAlignment="Center"
                                           Margin="0,0,8,0"/>
                                <TextBlock x:Name="txtHorarioSistema"
                                           Text="14:30:00"
                                           FontSize="13"
                                           FontWeight="SemiBold"
                                           Foreground="#1A4D7A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Conteúdo com Atalhos -->
            <ScrollViewer Grid.Row="1" 
                         VerticalScrollBarVisibility="Auto"
                         Margin="12,12,8,8">
                <StackPanel>

                    <!-- Seção de Atalhos Rápidos -->
                    <Border Background="White"
                            CornerRadius="12"
                            Padding="24"
                            Margin="0,0,0,16"
                            BorderBrush="#E0E0E0"
                            BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                        </Border.Effect>

                        <StackPanel>
                            <TextBlock Text="⚡ Atalhos Rápidos" 
                                       FontSize="18" 
                                       FontWeight="Bold"
                                       Foreground="#1A4D7A"
                                       Margin="0,0,0,20"/>

                            <WrapPanel HorizontalAlignment="Left">

                                <!-- Card Vendas -->
                                <Border Style="{StaticResource ShortcutCardStyle}"
                                        MouseLeftButtonDown="Border_MouseLeftButtonDown_Vendas">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="💰" Style="{StaticResource CardIconStyle}"/>
                                        <TextBlock Text="Vendas" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Processar vendas" Style="{StaticResource CardDescriptionStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card Produtos -->
                                <Border Style="{StaticResource ShortcutCardStyle}"
                                        MouseLeftButtonDown="Border_MouseLeftButtonDown">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📦" Style="{StaticResource CardIconStyle}"/>
                                        <TextBlock Text="Produtos" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Gestão de produtos" Style="{StaticResource CardDescriptionStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card Estoque -->
                                <Border Style="{StaticResource ShortcutCardStyle}"
                                        MouseLeftButtonDown="Border_MouseLeftButtonDown_Estoque">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📊" Style="{StaticResource CardIconStyle}"/>
                                        <TextBlock Text="Estoque" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Controle de estoque" Style="{StaticResource CardDescriptionStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card Clientes -->
                                <Border Style="{StaticResource ShortcutCardStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="👨‍💼" Style="{StaticResource CardIconStyle}"/>
                                        <TextBlock Text="Clientes" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Gestão de clientes" Style="{StaticResource CardDescriptionStyle}"/>
                                    </StackPanel>
                                </Border>

                                <!-- Card Relatórios -->
                                <Border Style="{StaticResource ShortcutCardStyle}">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="📈" Style="{StaticResource CardIconStyle}"/>
                                        <TextBlock Text="Relatórios" Style="{StaticResource CardTitleStyle}"/>
                                        <TextBlock Text="Análises gerenciais" Style="{StaticResource CardDescriptionStyle}"/>
                                    </StackPanel>
                                </Border>

                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Cards de Estatísticas -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Card Vendas Hoje -->
                        <Border Grid.Column="0"
                                Background="White"
                                CornerRadius="12"
                                Padding="20"
                                Margin="0,0,8,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="💵" FontSize="32" Margin="0,0,0,8"/>
                                <TextBlock Text="Vendas Hoje" 
                                          FontSize="12" 
                                          Foreground="#666666"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="R$ 0,00" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#1A4D7A"/>
                            </StackPanel>
                        </Border>

                        <!-- Card Produtos Cadastrados -->
                        <Border Grid.Column="1"
                                Background="White"
                                CornerRadius="12"
                                Padding="20"
                                Margin="4,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="📦" FontSize="32" Margin="0,0,0,8"/>
                                <TextBlock Text="Produtos" 
                                          FontSize="12" 
                                          Foreground="#666666"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="0" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#1A4D7A"/>
                            </StackPanel>
                        </Border>

                        <!-- Card Estoque Baixo -->
                        <Border Grid.Column="2"
                                Background="White"
                                CornerRadius="12"
                                Padding="20"
                                Margin="8,0,0,0"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                            </Border.Effect>
                            <StackPanel>
                                <TextBlock Text="⚠️" FontSize="32" Margin="0,0,0,8"/>
                                <TextBlock Text="Estoque Baixo" 
                                          FontSize="12" 
                                          Foreground="#666666"
                                          Margin="0,0,0,4"/>
                                <TextBlock Text="0" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#DC3545"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                </StackPanel>
            </ScrollViewer>

            <!-- Rodapé Fixo -->
            <Border Grid.Row="2"
                    Background="White"
                    CornerRadius="12"
                    Padding="20"
                    Margin="12,0,8,8"
                    BorderBrush="#E0E0E0"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                </Border.Effect>
                <Grid>
                    <TextBlock Text="© 2026 Smart System PDV - Business Solution"
                               Foreground="#1A4D7A"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Left"/>

                    <TextBlock Text="Versão 1.0.0"
                               Foreground="#1A4D7A"
                               FontSize="11"
                               VerticalAlignment="Center"
                               HorizontalAlignment="Right"/>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>