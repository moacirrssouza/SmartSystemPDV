<Window x:Class="SmartSystemPDV.View.Vendas.VendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.Vendas"
        xmlns:controls="clr-namespace:SmartSystemPDV.Controls"
        mc:Ignorable="d"
        Title="PDV - Ponto de Venda" 
        Height="750" 
        Width="1400"
        MinHeight="700"
        MinWidth="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        Loaded="Window_Loaded">

    <Window.Resources>
        <!-- Estilos Base -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ScrollViewer x:Name="PART_ContentHost"
                                        Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsFocused" Value="True">
                    <Setter Property="BorderBrush" Value="#1A4D7A"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LargeTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="42"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- Estilos de Botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#17A2B8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#138496"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="36"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <!-- Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="18"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Botões Numéricos -->
        <Style x:Key="NumericButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="22"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F8FF"/>
                    <Setter Property="BorderBrush" Value="#1A4D7A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0F0FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" 
                            Click="BtnVoltar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="22"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Width="40"
                            Height="40"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A5D8A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="🛒 PDV - Ponto de Venda" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <Border Background="#2A5D8A"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,12,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" 
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock Text="Operador: Admin" 
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Border Background="#2A5D8A"
                            CornerRadius="4"
                            Padding="10,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🕐" 
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Margin="0,0,6,0"/>
                            <TextBlock x:Name="txtDataHoraAtual"
                                       Text="29/12/2025 14:30" 
                                       Foreground="White"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="750"/>
                <ColumnDefinition Width="420"/>
            </Grid.ColumnDefinitions>

            <!-- Painel Esquerdo -->
            <Grid Grid.Column="0" Margin="20,20,10,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Busca de Produto -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="🔍 Adicionar Produto" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="180"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Código/Barras -->
                            <StackPanel Grid.Column="0" Margin="0,0,0,10">
                                <Label Content="Código/Barras:" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtCodigoProduto"
                                        Style="{StaticResource LargeTextBox}"
                                        KeyDown="TxtCodigoProduto_KeyDown"/>
                            </StackPanel>

                            <!-- Produto com Busca -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <Label Content="Produto:" Style="{StaticResource ModernLabel}"/>
                                <controls:SearchableComboBox x:Name="cbProduto"
                                                            Height="42"
                                                            Placeholder="Digite para buscar produto..."
                                                            SelectionChanged="CbProduto_SelectionChanged"/>
                            </StackPanel>

                            <!-- Quantidade -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <Label Content="Quantidade:" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtQuantidadeProduto"
                                        Style="{StaticResource LargeTextBox}"
                                        Text="1"
                                        PreviewTextInput="TextBox_PreviewTextInputDecimal"/>
                            </StackPanel>

                            <!-- Botão Adicionar -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <Button Content="➕ Adicionar"
                                       Style="{StaticResource SuccessButton}"
                                       Height="42"
                                       Width="140"
                                       Margin="0"
                                       FontSize="14"
                                       Click="BtnAdicionar_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Carrinho -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <TextBlock Text="🛒 Itens da Venda" 
                                      FontSize="16" 
                                      FontWeight="Bold"
                                      Foreground="#1A4D7A"
                                      VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✏️ Editar"
                                       Style="{StaticResource InfoButton}"
                                       Width="100"
                                       Margin="0,0,8,0"
                                       Click="BtnEditarItem_Click"/>
                                <Button Content="🗑️ Remover"
                                       Style="{StaticResource DangerButton}"
                                       Width="100"
                                       Margin="0"
                                       Click="BtnRemoverItem_Click"/>
                            </StackPanel>
                        </Grid>

                        <DataGrid Grid.Row="1"
                                 x:Name="dgCarrinho"
                                 Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding ProdutoCodigo}" Width="75"/>
                                <DataGridTextColumn Header="Produto" Binding="{Binding ProdutoNome}" Width="*" MinWidth="200"/>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="60"/>
                                <DataGridTextColumn Header="Preço Unit." Binding="{Binding PrecoUnitario, StringFormat=C2}" Width="100"/>
                                <DataGridTextColumn Header="Desconto" Binding="{Binding Desconto, StringFormat=C2}" Width="95"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="110"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Resumo -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,16,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" HorizontalAlignment="Center">
                            <TextBlock Text="Itens no Carrinho" 
                                      FontSize="11" 
                                      Foreground="#666666"
                                      TextAlignment="Center"
                                      Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="📦" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.5"/>
                                <TextBlock x:Name="txtTotalItens"
                                          Text="0" 
                                          FontSize="28" 
                                          FontWeight="Bold"
                                          Foreground="#1A4D7A"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Center">
                            <TextBlock Text="Desconto Total" 
                                      FontSize="11" 
                                      Foreground="#666666"
                                      TextAlignment="Center"
                                      Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="🏷️" FontSize="20" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.5"/>
                                <TextBlock x:Name="txtDescontoTotal"
                                          Text="R$ 0,00" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#FFC107"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" HorizontalAlignment="Center">
                            <TextBlock Text="Total da Venda" 
                                      FontSize="11" 
                                      Foreground="#666666"
                                      TextAlignment="Center"
                                      Margin="0,0,0,6"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <TextBlock Text="💰" FontSize="22" VerticalAlignment="Center" Margin="0,0,8,0" Opacity="0.5"/>
                                <TextBlock x:Name="txtTotalVenda"
                                          Text="R$ 0,00" 
                                          FontSize="32" 
                                          FontWeight="Bold"
                                          Foreground="#28A745"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Painel Direito - Pagamento -->
            <Grid Grid.Column="1" Margin="10,20,20,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Cliente -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="👤 Cliente" 
                                  FontSize="16" 
                                  FontWeight="Bold"
                                  Foreground="#1A4D7A"
                                  Margin="0,0,0,12"/>

                        <controls:SearchableComboBox x:Name="cbCliente"
                                                    Height="42"
                                                    Placeholder="Selecione o cliente..."
                                                    SelectionChanged="CbCliente_SelectionChanged"/>
                    </StackPanel>
                </Border>

                <!-- Pagamento -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="💳 Forma de Pagamento" 
                                  FontSize="16" 
                                  FontWeight="Bold"
                                  Foreground="#1A4D7A"
                                  Margin="0,0,0,12"/>

                        <controls:SearchableComboBox x:Name="cbFormaPagamento"
                                                    Height="42"
                                                    Margin="0,0,0,12"
                                                    Placeholder="Selecione forma de pagamento..."
                                                    SelectionChanged="CbFormaPagamento_SelectionChanged"/>

                        <!-- Painel Dinheiro -->
                        <StackPanel x:Name="pnlDinheiro" Visibility="Collapsed">
                            <Label Content="Valor Pago:" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtValorPago"
                                    Style="{StaticResource LargeTextBox}"
                                    Margin="0,0,0,10"
                                    TextChanged="TxtValorPago_TextChanged"
                                    PreviewTextInput="TextBox_PreviewTextInputDecimal"/>

                            <Label Content="Troco:" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtTroco"
                                    Style="{StaticResource LargeTextBox}"
                                    IsReadOnly="True"
                                    Background="#E8F5E9"
                                    Text="R$ 0,00"
                                    FontSize="18"
                                    FontWeight="Bold"
                                    Foreground="#28A745"/>
                        </StackPanel>

                        <!-- Painel Parcelas -->
                        <StackPanel x:Name="pnlParcelas" Visibility="Collapsed">
                            <Label Content="Parcelas:" Style="{StaticResource ModernLabel}"/>
                            <controls:SearchableComboBox x:Name="cbParcelas"
                                                        Height="42"
                                                        Margin="0,0,0,10"
                                                        Placeholder="Selecione parcelas..."
                                                        SelectionChanged="CbParcelas_SelectionChanged"/>

                            <Label Content="Valor da Parcela:" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtValorParcela"
                                    Style="{StaticResource ModernTextBox}"
                                    IsReadOnly="True"
                                    Background="#F8F9FA"
                                    FontWeight="SemiBold"
                                    Text="R$ 0,00"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Teclado Numérico -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                  Text="⌨️ Teclado Numérico" 
                                  FontSize="14" 
                                  FontWeight="Bold"
                                  Foreground="#1A4D7A"
                                  Margin="0,0,0,12"/>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>

                            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>

                            <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>

                            <Button Grid.Row="3" Grid.Column="0" Content="," Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource NumericButton}" Click="BtnBackspace_Click" FontSize="18"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Botões de Ação -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Button Content="✅ FINALIZAR VENDA (F2)"
                               Style="{StaticResource SuccessButton}"
                               Height="56"
                               FontSize="16"
                               Margin="0,0,0,10"
                               Click="BtnFinalizarVenda_Click"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="❌ Cancelar"
                                   Style="{StaticResource DangerButton}"
                                   Height="40"
                                   Margin="0,0,5,0"
                                   Click="BtnCancelarVenda_Click"/>

                            <Button Grid.Column="1"
                                   Content="💾 Suspender"
                                   Style="{StaticResource WarningButton}"
                                   Height="40"
                                   Margin="5,0,0,0"
                                   Click="BtnSuspenderVenda_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>