<Window x:Class="SmartSystemPDV.View.Vendas.VendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.Vendas"
        mc:Ignorable="d"
        Title="PDV - Ponto de Venda" Height="700" Width="1400" WindowState="Maximized">
    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Estilo para TextBox Grande -->
        <Style x:Key="LargeTextBox" TargetType="TextBox" BasedOn="{StaticResource ModernTextBox}">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="Height" Value="45"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#17A2B8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#138496"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="40"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Estilo para Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Botões Numéricos -->
        <Style x:Key="NumericButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F0F0"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0E0E0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Button Content="←" 
                            Click="BtnVoltar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Padding="10,0"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="🛒 PDV - Ponto de Venda" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="20,0">
                    <TextBlock Text="Operador: Admin" 
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <TextBlock x:Name="txtDataHoraAtual"
                               Text="29/12/2025 14:30" 
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*"/>
                <ColumnDefinition Width="*" MinWidth="450"/>
            </Grid.ColumnDefinitions>

            <!-- Painel Esquerdo - Produtos e Carrinho -->
            <Grid Grid.Column="0" Margin="15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Busca de Produto -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="Adicionar Produto" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,15"/>

                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="200"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="150"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Código/Barras -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Label Content="Código/Barras:" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtCodigoProduto"
                                        Style="{StaticResource LargeTextBox}"
                                        KeyDown="TxtCodigoProduto_KeyDown"
                                        PreviewTextInput="TextBox_PreviewTextInputNumeric"/>
                            </StackPanel>

                            <!-- Nome do Produto -->
                            <StackPanel Grid.Column="1" Margin="0,0,10,0">
                                <Label Content="Produto:" Style="{StaticResource ModernLabel}"/>
                                <ComboBox x:Name="cbProduto"
                                         Style="{StaticResource ModernComboBox}"
                                         Height="45"
                                         FontSize="16"
                                         SelectionChanged="CbProduto_SelectionChanged">
                                    <ComboBoxItem Content="Selecione ou digite código..." IsSelected="True"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Quantidade -->
                            <StackPanel Grid.Column="2" Margin="0,0,10,0">
                                <Label Content="Quantidade:" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtQuantidadeProduto"
                                        Style="{StaticResource LargeTextBox}"
                                        Text="1"
                                        PreviewTextInput="TextBox_PreviewTextInputNumeric"/>
                            </StackPanel>

                            <!-- Botão Adicionar -->
                            <StackPanel Grid.Column="3" VerticalAlignment="Bottom">
                                <Button Content="+ Adicionar"
                                       Style="{StaticResource SuccessButton}"
                                       Height="45"
                                       Width="150"
                                       Margin="0"
                                       FontSize="16"
                                       Click="BtnAdicionar_Click"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Carrinho de Compras -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0" Margin="0,0,0,15">
                            <TextBlock Text="Itens da Venda" 
                                      FontSize="18" 
                                      FontWeight="Bold"
                                      Foreground="#1A4D7A"
                                      VerticalAlignment="Center"/>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="✏️ Editar Item"
                                       Style="{StaticResource InfoButton}"
                                       Margin="0,0,10,0"
                                       Click="BtnEditarItem_Click"/>
                                <Button Content="🗑️ Remover Item"
                                       Style="{StaticResource DangerButton}"
                                       Margin="0"
                                       Click="BtnRemoverItem_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- DataGrid Carrinho -->
                        <DataGrid Grid.Row="1"
                                 x:Name="dgCarrinho"
                                 Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/>
                                <DataGridTextColumn Header="Qtd" Binding="{Binding Quantidade}" Width="70"/>
                                <DataGridTextColumn Header="Preço Unit." Binding="{Binding PrecoUnitario, StringFormat=C2}" Width="110"/>
                                <DataGridTextColumn Header="Desconto" Binding="{Binding Desconto, StringFormat=C2}" Width="100"/>
                                <DataGridTextColumn Header="Subtotal" Binding="{Binding Subtotal, StringFormat=C2}" Width="120"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Border>

                <!-- Resumo Rápido -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,15,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Itens no Carrinho" 
                                      FontSize="12" 
                                      Foreground="#666666"
                                      Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtTotalItens"
                                      Text="0" 
                                      FontSize="24" 
                                      FontWeight="Bold"
                                      Foreground="#1A4D7A"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Desconto Total" 
                                      FontSize="12" 
                                      Foreground="#666666"
                                      Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtDescontoTotal"
                                      Text="R$ 0,00" 
                                      FontSize="24" 
                                      FontWeight="Bold"
                                      Foreground="#FFC107"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Total da Venda" 
                                      FontSize="12" 
                                      Foreground="#666666"
                                      Margin="0,0,0,5"/>
                            <TextBlock x:Name="txtTotalVenda"
                                      Text="R$ 0,00" 
                                      FontSize="28" 
                                      FontWeight="Bold"
                                      Foreground="#28A745"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Painel Direito - Pagamento e Ações -->
            <Grid Grid.Column="1" Margin="0,15,15,15">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Dados do Cliente -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Cliente" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="#1A4D7A"
                                  Margin="0,0,0,15"/>

                        <Label Content="Nome/CPF:" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbCliente"
                                 Style="{StaticResource ModernComboBox}"
                                 Margin="0,0,0,10"
                                 IsEditable="True">
                            <ComboBoxItem Content="Cliente Padrão" IsSelected="True"/>
                        </ComboBox>

                        <Button Content="+ Novo Cliente"
                               Style="{StaticResource InfoButton}"
                               Margin="0"
                               Width="150"
                               HorizontalAlignment="Left"
                               Click="BtnNovoCliente_Click"/>
                    </StackPanel>
                </Border>

                <!-- Forma de Pagamento -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <StackPanel>
                        <TextBlock Text="Forma de Pagamento" 
                                  FontSize="18" 
                                  FontWeight="Bold"
                                  Foreground="#1A4D7A"
                                  Margin="0,0,0,15"/>

                        <Label Content="Método:" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbFormaPagamento"
                                 Style="{StaticResource ModernComboBox}"
                                 Margin="0,0,0,15"
                                 SelectionChanged="CbFormaPagamento_SelectionChanged">
                            <ComboBoxItem Content="Dinheiro" IsSelected="True"/>
                            <ComboBoxItem Content="Cartão de Débito"/>
                            <ComboBoxItem Content="Cartão de Crédito"/>
                            <ComboBoxItem Content="PIX"/>
                            <ComboBoxItem Content="Boleto"/>
                            <ComboBoxItem Content="Crediário"/>
                        </ComboBox>

                        <!-- Valor Pago (para Dinheiro) -->
                        <StackPanel x:Name="pnlDinheiro" Visibility="Visible">
                            <Label Content="Valor Pago:" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtValorPago"
                                    Style="{StaticResource LargeTextBox}"
                                    Margin="0,0,0,10"
                                    TextChanged="TxtValorPago_TextChanged"
                                    PreviewTextInput="TextBox_PreviewTextInputDecimal"/>

                            <Label Content="Troco:" Style="{StaticResource ModernLabel}"/>
                            <TextBox x:Name="txtTroco"
                                    Style="{StaticResource LargeTextBox}"
                                    IsReadOnly="True"
                                    Background="#E8F5E9"
                                    Text="R$ 0,00"
                                    FontWeight="Bold"
                                    Foreground="#28A745"/>
                        </StackPanel>

                        <!-- Parcelas (para Crédito) -->
                        <StackPanel x:Name="pnlParcelas" Visibility="Collapsed">
                            <Label Content="Parcelas:" Style="{StaticResource ModernLabel}"/>
                            <ComboBox x:Name="cbParcelas"
                                     Style="{StaticResource ModernComboBox}"
                                     SelectionChanged="CbParcelas_SelectionChanged">
                                <ComboBoxItem Content="1x sem juros" IsSelected="True"/>
                                <ComboBoxItem Content="2x sem juros"/>
                                <ComboBoxItem Content="3x sem juros"/>
                                <ComboBoxItem Content="4x com juros"/>
                                <ComboBoxItem Content="5x com juros"/>
                                <ComboBoxItem Content="6x com juros"/>
                            </ComboBox>

                            <Label Content="Valor da Parcela:" Style="{StaticResource ModernLabel}" Margin="0,10,0,0"/>
                            <TextBox x:Name="txtValorParcela"
                                    Style="{StaticResource ModernTextBox}"
                                    IsReadOnly="True"
                                    Background="#F0F0F0"
                                    Text="R$ 0,00"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Teclado Numérico -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,15">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                  Text="Teclado Numérico" 
                                  FontSize="16" 
                                  FontWeight="Bold"
                                  Foreground="#1A4D7A"
                                  Margin="0,0,0,15"/>

                        <Grid Grid.Row="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Linha 1 -->
                            <Button Grid.Row="0" Grid.Column="0" Content="7" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="0" Grid.Column="1" Content="8" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="0" Grid.Column="2" Content="9" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>

                            <!-- Linha 2 -->
                            <Button Grid.Row="1" Grid.Column="0" Content="4" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="1" Grid.Column="1" Content="5" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="1" Grid.Column="2" Content="6" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>

                            <!-- Linha 3 -->
                            <Button Grid.Row="2" Grid.Column="0" Content="1" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="2" Grid.Column="1" Content="2" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="2" Grid.Column="2" Content="3" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>

                            <!-- Linha 4 -->
                            <Button Grid.Row="3" Grid.Column="0" Content="," Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="3" Grid.Column="1" Content="0" Style="{StaticResource NumericButton}" Click="BtnNumerico_Click"/>
                            <Button Grid.Row="3" Grid.Column="2" Content="⌫" Style="{StaticResource NumericButton}" Click="BtnBackspace_Click" FontSize="20"/>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Botões de Ação -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Button Content="💰 FINALIZAR VENDA (F2)"
                               Style="{StaticResource SuccessButton}"
                               Height="60"
                               FontSize="18"
                               Margin="0,0,0,10"
                               Click="BtnFinalizarVenda_Click"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                   Content="🗑️ Cancelar"
                                   Style="{StaticResource DangerButton}"
                                   Height="45"
                                   Margin="0,0,5,0"
                                   Click="BtnCancelarVenda_Click"/>

                            <Button Grid.Column="1"
                                   Content="💾 Suspender"
                                   Style="{StaticResource WarningButton}"
                                   Height="45"
                                   Margin="5,0,0,0"
                                   Click="BtnSuspenderVenda_Click"/>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>