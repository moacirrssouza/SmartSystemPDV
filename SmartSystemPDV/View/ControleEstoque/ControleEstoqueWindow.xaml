<Window x:Class="SmartSystemPDV.View.ControleEstoque.ControleEstoqueWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.ControleEstoque"
        mc:Ignorable="d"
        Title="Controle de Estoque" 
        Height="700" 
        Width="1400"
        MinHeight="600"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="InfoButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#17A2B8"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#138496"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <!-- Estilo para Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para Cards de Resumo -->
        <Style x:Key="SummaryCardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.12" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" 
                            Click="BtnVoltar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="22"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Width="40"
                            Height="40"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A5D8A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="📊 Controle de Estoque" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="Usuário: Admin"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- Cards de Resumo -->
        <Grid Grid.Row="1" Margin="20,16,20,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Card Total de Produtos -->
            <Border Grid.Column="0" Style="{StaticResource SummaryCardStyle}" Margin="0,0,8,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Total de Produtos" 
                                   FontSize="12" 
                                   Foreground="#666666"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtTotalProdutos" 
                                       Text="{Binding TotalProdutos}" 
                                       FontSize="28" 
                                       FontWeight="Bold"
                                       Foreground="#1A4D7A"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="📦" 
                                       FontSize="32" 
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.25"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card Valor Total -->
            <Border Grid.Column="1" Style="{StaticResource SummaryCardStyle}" Margin="8,0,8,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Valor Total Estoque" 
                                   FontSize="12" 
                                   Foreground="#666666"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtValorTotal" 
                                       Text="{Binding ValorTotalEstoque, StringFormat=C2}" 
                                       FontSize="24" 
                                       FontWeight="Bold"
                                       Foreground="#28A745"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="💰" 
                                       FontSize="32" 
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.25"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card Alertas -->
            <Border Grid.Column="2" Style="{StaticResource SummaryCardStyle}" Margin="8,0,8,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Estoque Baixo" 
                                   FontSize="12" 
                                   Foreground="#666666"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtEstoqueBaixo" 
                                       Text="0" 
                                       FontSize="28" 
                                       FontWeight="Bold"
                                       Foreground="#DC3545"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="⚠️" 
                                       FontSize="32" 
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.25"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Card Produtos Ativos -->
            <Border Grid.Column="3" Style="{StaticResource SummaryCardStyle}" Margin="8,0,0,0">
                <Grid>
                    <StackPanel>
                        <TextBlock Text="Produtos Ativos" 
                                   FontSize="12" 
                                   Foreground="#666666"
                                   Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock x:Name="txtProdutosAtivos" 
                                       Text="{Binding ProdutosAtivosCount}" 
                                       FontSize="28" 
                                       FontWeight="Bold"
                                       Foreground="#17A2B8"
                                       VerticalAlignment="Center"/>
                            <TextBlock Text="✓" 
                                       FontSize="32" 
                                       Margin="12,0,0,0"
                                       VerticalAlignment="Center"
                                       Opacity="0.25"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="2" Margin="20,16,20,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel de Movimentação -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Stretch">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Movimentação de Estoque" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,16"/>

                        <!-- Tipo de Movimentação -->
                        <Label Content="Tipo de Movimentação:*" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbTipoMovimentacao" 
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,12"
                                  SelectedValue="{Binding TipoMovimentacao}"
                                  SelectedValuePath="Tag">
                            <ComboBoxItem Content="Entrada" Tag="Entrada"/>
                            <ComboBoxItem Content="Saída" Tag="Saída"/>
                        </ComboBox>

                        <!-- Produto -->
                        <Label Content="Produto:*" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbProduto" 
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,12"
                                  ItemsSource="{Binding Produtos}"
                                  SelectedItem="{Binding ProdutoSelecionado}"
                                  DisplayMemberPath="Nome">
                        </ComboBox>

                        <!-- Estoque Atual -->
                        <Label Content="Estoque Atual:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtEstoqueAtual" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,12"
                                 IsReadOnly="True"
                                 Background="#F8F9FA"
                                 Text="{Binding ProdutoSelecionado.Estoque, Mode=OneWay}"/>

                        <!-- Quantidade -->
                        <Label Content="Quantidade:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtQuantidade" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,12"
                                 PreviewTextInput="TextBox_PreviewTextInputNumeric"
                                 Text="{Binding Quantidade, UpdateSourceTrigger=PropertyChanged}"/>

                        <!-- Novo Estoque (Preview) -->
                        <Label Content="Novo Estoque:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtNovoEstoque" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,12"
                                 IsReadOnly="True"
                                 Background="#E8F5E9"
                                 FontWeight="Bold"
                                 Text="{Binding NovoEstoque, Mode=OneWay}"/>

                        <!-- Motivo -->
                        <Label Content="Motivo/Observação:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtMotivo" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="70"
                                 Padding="10"
                                 FontSize="13"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,12"
                                 VerticalScrollBarVisibility="Auto"
                                 Text="{Binding Motivo}"/>

                        <!-- Data e Hora -->
                        <Label Content="Data/Hora:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtDataHora" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,16"
                                 IsReadOnly="True"
                                 Background="#F8F9FA"
                                 Text="{Binding DataHoraAtual, Mode=OneWay}"/>

                        <TextBlock Text="* Campos obrigatórios" 
                                   FontSize="10"
                                   Foreground="#999999"
                                   FontStyle="Italic"
                                   Margin="0,0,0,16"/>

                        <!-- Botões de Ação -->
                        <StackPanel>
                            <Button x:Name="btnRegistrar"
                                    Content="✓ Registrar Movimentação"
                                    Style="{StaticResource SuccessButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,8"
                                    Command="{Binding SalvarMovimentacaoCommand}"/>

                            <Button x:Name="btnLimpar"
                                    Content="Limpar"
                                    Style="{StaticResource WarningButton}"
                                    HorizontalAlignment="Stretch"
                                    Command="{Binding LimparCamposCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Painel de Histórico e Estoque -->
            <Grid Grid.Column="1" Margin="10,0,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="1.2*"/>
                </Grid.RowDefinitions>

                <!-- Histórico de Movimentações -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0"
                                   Text="📋 Histórico de Movimentações" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,12"/>

                        <!-- Filtros -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>

                            <ComboBox x:Name="cbFiltroTipo"
                                      Grid.Column="0"
                                      Style="{StaticResource ModernComboBox}"
                                      Margin="0,0,8,0"
                                      SelectedValue="{Binding FiltroTipoMovimentacao}"
                                      SelectedValuePath="Content">
                                <ComboBoxItem Content="Todos os Tipos" IsSelected="True"/>
                                <ComboBoxItem Content="Entrada"/>
                                <ComboBoxItem Content="Saída"/>
                                <ComboBoxItem Content="Ajuste"/>
                                <ComboBoxItem Content="Devolução"/>
                                <ComboBoxItem Content="Perda"/>
                            </ComboBox>

                            <DatePicker x:Name="dpDataInicio"
                                       Grid.Column="1"
                                       Height="32"
                                       Margin="0,0,8,0"
                                       FontSize="12"
                                       SelectedDate="{Binding DataInicio}"/>

                            <DatePicker x:Name="dpDataFim"
                                       Grid.Column="2"
                                       Height="32"
                                       FontSize="12"
                                       SelectedDate="{Binding DataFim}"/>
                        </Grid>

                        <!-- Container para DataGrid e Paginação -->
                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- DataGrid Histórico -->
                            <DataGrid Grid.Row="0"
                                      x:Name="dgHistorico"
                                      Style="{StaticResource ModernDataGrid}"
                                      ItemsSource="{Binding Movimentacoes}"
                                      Margin="0,0,0,10">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Data/Hora" Binding="{Binding DataHora, StringFormat={}{0:dd/MM/yy HH:mm}}" Width="105"/>
                                    <DataGridTextColumn Header="Tipo" Binding="{Binding Tipo}" Width="85"/>
                                    <DataGridTextColumn Header="Produto" Binding="{Binding NomeProduto}" Width="*" MinWidth="120"/>
                                    <DataGridTextColumn Header="Anterior" Binding="{Binding QuantidadeAnterior}" Width="70"/>
                                    <DataGridTextColumn Header="Movim." Binding="{Binding Quantidade}" Width="65"/>
                                    <DataGridTextColumn Header="Final" Binding="{Binding QuantidadeFinal}" Width="60"/>
                                    <DataGridTextColumn Header="Motivo" Binding="{Binding Motivo}" Width="*" MinWidth="150"/>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Paginação Histórico -->
                            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                                <Button Content="❮ Anterior" 
                                        Command="{Binding AnteriorPaginaHistoricoCommand}"
                                        Width="100" Margin="0,0,10,0"
                                        Style="{StaticResource InfoButton}"/>
                                <TextBlock Text="{Binding PaginaAtualHistorico, StringFormat='Página {0}'}" 
                                           VerticalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                                <TextBlock Text=" de " VerticalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                                <TextBlock Text="{Binding TotalPaginasHistorico}" 
                                           VerticalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                                <Button Content="Próxima ❯" 
                                        Command="{Binding ProximaPaginaHistoricoCommand}"
                                        Width="100" Margin="10,0,0,0"
                                        Style="{StaticResource InfoButton}"/>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>

                <!-- Estoque Atual de Produtos -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Título -->
                        <TextBlock Grid.Row="0"
                                   Text="📦 Situação Atual do Estoque" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,12"/>

                        <!-- Pesquisa -->
                        <Grid Grid.Row="1" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Margin="0,0,8,0">
                                <TextBox x:Name="txtPesquisaEstoque"
                                         Style="{StaticResource ModernTextBox}"
                                         Text="{Binding FiltroTexto, UpdateSourceTrigger=PropertyChanged}"/>

                                <TextBlock IsHitTestVisible="False"
                                           Text="🔍 Pesquisar produto..."
                                           VerticalAlignment="Center"
                                           HorizontalAlignment="Left"
                                           Margin="12,0,0,0"
                                           Foreground="#999999"
                                           FontSize="13">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=txtPesquisaEstoque}" Value="">
                                                    <Setter Property="Visibility" Value="Visible"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <Button Grid.Column="1"
                                    Content="🔄 Atualizar"
                                    Style="{StaticResource InfoButton}"
                                    Width="110"
                                    Command="{Binding BuscarMovimentacoesCommand}"/>
                        </Grid>

                        <!-- DataGrid Estoque -->
                        <DataGrid Grid.Row="2"
                                  x:Name="dgEstoque"
                                  Style="{StaticResource ModernDataGrid}"
                                  ItemsSource="{Binding Produtos}"
                                  SelectedItem="{Binding ProdutoSelecionado}"
                                  Margin="0,0,0,10">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="65"/>
                                <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*" MinWidth="150"/>
                                <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="110"/>
                                <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="70"/>
                                <DataGridTextColumn Header="Mínimo" Binding="{Binding EstoqueMinimo}" Width="70"/>
                                <DataGridTextColumn Header="Preço Unit." Binding="{Binding PrecoVenda, StringFormat=C2}" Width="90"/>
                                <DataGridTextColumn Header="Valor Total" Binding="{Binding ValorTotal, StringFormat=C2}" Width="100"/>
                                <DataGridTextColumn Header="Status" Binding="{Binding StatusEstoque}" Width="75"/>
                            </DataGrid.Columns>
                            <DataGrid.RowStyle>
                                <Style TargetType="DataGridRow">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusEstoque}" Value="Crítico">
                                            <Setter Property="Background" Value="#FFEBEE"/>
                                            <Setter Property="Foreground" Value="#C62828"/>
                                            <Setter Property="FontWeight" Value="SemiBold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusEstoque}" Value="Baixo">
                                            <Setter Property="Background" Value="#FFF3E0"/>
                                            <Setter Property="Foreground" Value="#E65100"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DataGrid.RowStyle>
                        </DataGrid>

                        <!-- Paginação Estoque -->
                        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left" Margin="0,10,0,0">
                            <Button Content="❮ Anterior" 
                                    Command="{Binding AnteriorPaginaEstoqueCommand}"
                                    Width="100" Margin="0,0,10,0"
                                    Style="{StaticResource InfoButton}"/>
                            <TextBlock Text="{Binding PaginaAtualEstoque, StringFormat='Página {0}'}" 
                                       VerticalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                            <TextBlock Text=" de " VerticalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                            <TextBlock Text="{Binding TotalPaginasEstoque}" 
                                       VerticalAlignment="Center" FontWeight="Bold" Foreground="#666"/>
                            <Button Content="Próxima ❯" 
                                    Command="{Binding ProximaPaginaEstoqueCommand}"
                                    Width="100" Margin="10,0,0,0"
                                    Style="{StaticResource InfoButton}"/>
                        </StackPanel>

                        <!-- Legenda -->
                        <StackPanel Grid.Row="3" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Right"
                                   Margin="0,10,0,0">
                            <Border Background="#FFEBEE" 
                                    Padding="8,4" 
                                    CornerRadius="3"
                                    BorderBrush="#FFCDD2"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock Text="■ Crítico (0)" 
                                           FontSize="11"
                                           Foreground="#C62828"
                                           FontWeight="SemiBold"/>
                            </Border>
                            <Border Background="#FFF3E0" 
                                    Padding="8,4" 
                                    CornerRadius="3"
                                    BorderBrush="#FFE0B2"
                                    BorderThickness="1"
                                    Margin="0,0,8,0">
                                <TextBlock Text="■ Baixo (≤ Mínimo)" 
                                           FontSize="11"
                                           Foreground="#E65100"/>
                            </Border>
                            <Border Background="#E8F5E9" 
                                    Padding="8,4" 
                                    CornerRadius="3"
                                    BorderBrush="#C8E6C9"
                                    BorderThickness="1">
                                <TextBlock Text="■ Normal" 
                                           FontSize="11"
                                           Foreground="#2E7D32"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Window>
