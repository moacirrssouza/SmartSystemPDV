<Window x:Class="SystemSmartPDV.View.Categorias.CategoriasWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemSmartPDV.View.Categorias"
        mc:Ignorable="d"
        Title="Cadastro de Categorias" 
        Height="700" 
        Width="1400"
        MinHeight="600"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <!-- Estilo para Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" 
                            Command="{Binding VoltarCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="22"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Width="40"
                            Height="40"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A5D8A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="📁 Cadastro de Categorias" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding UsuarioLogado, StringFormat='Usuário: {0}'}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel de Cadastro -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Stretch">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" IsEnabled="{Binding CamposHabilitados}">
                        <TextBlock Text="Dados da Categoria" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,16"/>

                        <!-- ID -->
                        <Label Content="ID:" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding Id}" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 IsReadOnly="True"
                                 Background="#F8F9FA"/>

                        <!-- Nome da Categoria -->
                        <Label Content="Nome da Categoria:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 MaxLength="100"/>

                        <!-- Descrição -->
                        <Label Content="Descrição:" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="80"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10"/>

                        <!-- Status Ativo -->
                        <CheckBox Content="Categoria Ativa" 
                                  IsChecked="{Binding Ativo}" 
                                  Style="{StaticResource ModernCheckBox}"
                                  Margin="0,5,0,20"/>

                        <!-- Informações adicionais -->
                        <Border Background="#F8F9FA" 
                                CornerRadius="4" 
                                Padding="12"
                                BorderBrush="#E0E0E0"
                                BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="ℹ️ Informações" 
                                           FontWeight="SemiBold"
                                           Foreground="#1A4D7A"
                                           Margin="0,0,0,8"/>
                                <TextBlock TextWrapping="Wrap"
                                           FontSize="11"
                                           Foreground="#666666"
                                           LineHeight="16">
                                    <Run Text="• Categorias ajudam a organizar seus produtos"/>
                                    <LineBreak/>
                                    <Run Text="• O nome da categoria é obrigatório"/>
                                    <LineBreak/>
                                    <Run Text="• Categorias inativas não aparecem no cadastro de produtos"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Botões de Ação - fixos no rodapé do card -->
                    <StackPanel Grid.Row="1" Margin="0,20,0,0">
                        <Button Content="🆕 Nova Categoria"
                                Command="{Binding NovoCommand}"
                                Style="{StaticResource PrimaryButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0,0,0,5"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0"
                                    Content="💾 Salvar"
                                    Command="{Binding SalvarCommand}"
                                    Style="{StaticResource SuccessButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,4,0"/>

                            <Button Grid.Column="1"
                                    Content="❌ Cancelar"
                                    Command="{Binding CancelarCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Lista de Categorias -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de Pesquisa e Ações -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pesquisa -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="10,0,35,0"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="🔍" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="#888888"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="Pesquisar categoria..." 
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="#AAAAAA">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TextoPesquisa}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                                Content="🔄 Atualizar"
                                Command="{Binding CarregarCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,5,0"
                                Width="100"/>

                        <Button Grid.Column="2"
                                Content="✏️ Editar"
                                Command="{Binding EditarCommand}"
                                Style="{StaticResource WarningButton}"
                                Margin="0,0,5,0"
                                Width="80"/>

                        <Button Grid.Column="3"
                                Content="🗑️ Excluir"
                                Command="{Binding ExcluirCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding CategoriasFiltradas}"
                              SelectedItem="{Binding CategoriaSelecionada}"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="60"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Descrição" Binding="{Binding Descricao}" Width="2*"/>
                            <DataGridTemplateColumn Header="Status" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#F8D7DA"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                            <Setter Property="Background" Value="#D4EDDA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Inativo"/>
                                                        <Setter Property="Foreground" Value="#721C24"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Ativo}" Value="True">
                                                                <Setter Property="Text" Value="Ativo"/>
                                                                <Setter Property="Foreground" Value="#155724"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rodapé / Informações -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="📊 Total de categorias: " 
                                       VerticalAlignment="Center" 
                                       Foreground="#666666"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding TotalCategorias}"
                                       VerticalAlignment="Center"
                                       Foreground="#1A4D7A"
                                       FontWeight="Bold"
                                       Margin="5,0,20,0"/>

                            <TextBlock Text="✅ Ativas: " 
                                       VerticalAlignment="Center" 
                                       Foreground="#666666"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CategoriasAtivas}"
                                       VerticalAlignment="Center"
                                       Foreground="#28A745"
                                       FontWeight="Bold"
                                       Margin="5,0,20,0"/>

                            <TextBlock Text="❌ Inativas: " 
                                       VerticalAlignment="Center" 
                                       Foreground="#666666"
                                       FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding CategoriasInativas}"
                                       VerticalAlignment="Center"
                                       Foreground="#DC3545"
                                       FontWeight="Bold"
                                       Margin="5,0,0,0"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>