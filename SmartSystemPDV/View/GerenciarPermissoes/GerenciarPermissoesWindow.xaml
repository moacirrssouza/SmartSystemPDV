<Window x:Class="SmartSystemPDV.View.GerenciarPermissoes.GerenciarPermissoesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.GerenciarPermissoes"
        mc:Ignorable="d"
        Title="Gerenciar Permissões" 
        Height="720" 
        Width="960"
        MinHeight="650"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize">

    <Window.Resources>
        <!-- Estilo para CheckBox -->
        <Style x:Key="ModernCheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="0,6"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para GroupBox -->
        <Style x:Key="ModernGroupBox" TargetType="GroupBox">
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="#1A4D7A"/>
            <Setter Property="Background" Value="#FAFBFC"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="75"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="70"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="24,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="🔐 Gerenciar Permissões de Acesso" 
                               FontSize="20" 
                               FontWeight="Bold" 
                               Foreground="White"
                               Margin="0,0,0,6"/>
                    <TextBlock x:Name="txtUsuarioNome"
                               Text="Usuário: [Nome]" 
                               FontSize="13" 
                               Foreground="#B8D4E8"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <Border Grid.Row="1" 
                Background="White" 
                Margin="20"
                CornerRadius="8"
                BorderBrush="#E0E0E0"
                BorderThickness="1">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
            </Border.Effect>

            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4">
                <StackPanel Margin="20">

                    <!-- Info do Perfil -->
                    <Border Background="#FFF3E0" 
                            Padding="14" 
                            CornerRadius="6"
                            Margin="0,0,0,16">
                        <StackPanel>
                            <TextBlock x:Name="txtPerfilAtual"
                                       Text="Perfil Atual: Administrador" 
                                       FontSize="13" 
                                       FontWeight="Bold"
                                       Foreground="#E65100"
                                       Margin="0,0,0,4"/>
                            <TextBlock Text="As permissões abaixo são baseadas no perfil selecionado. Você pode personalizar individualmente cada permissão." 
                                       FontSize="11" 
                                       Foreground="#666666"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Botões de Atalho -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="✓ Marcar Todas" 
                                Click="BtnMarcarTodas_Click"
                                Style="{StaticResource SuccessButton}"
                                Padding="14,8"/>
                        <Button Content="✗ Desmarcar Todas" 
                                Click="BtnDesmarcarTodas_Click"
                                Style="{StaticResource SecondaryButton}"
                                Padding="14,8"/>
                        <Button Content="🔄 Padrão do Perfil" 
                                Click="BtnRestaurarPadrao_Click"
                                Style="{StaticResource PrimaryButton}"
                                Padding="14,8"/>
                    </StackPanel>

                    <!-- Grid de 2 colunas para os módulos -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Coluna 1 -->
                        <StackPanel Grid.Column="0">
                            <!-- Módulo: Produtos -->
                            <GroupBox Header="📦 Produtos" Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <CheckBox x:Name="chkProdutosVisualizar" 
                                              Content="Visualizar Produtos" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkProdutosCadastrar" 
                                              Content="Cadastrar Produtos" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkProdutosEditar" 
                                              Content="Editar Produtos" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkProdutosExcluir" 
                                              Content="Excluir Produtos" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkProdutosImportar" 
                                              Content="Importar/Exportar" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Módulo: Estoque -->
                            <GroupBox Header="📊 Estoque" Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <CheckBox x:Name="chkEstoqueVisualizar" 
                                              Content="Visualizar Estoque" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkEstoqueEntrada" 
                                              Content="Registrar Entrada" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkEstoqueSaida" 
                                              Content="Registrar Saída" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkEstoqueAjuste" 
                                              Content="Ajustes de Estoque" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkEstoqueHistorico" 
                                              Content="Visualizar Histórico" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Módulo: Vendas -->
                            <GroupBox Header="💰 Vendas" Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <CheckBox x:Name="chkVendasVisualizar" 
                                              Content="Visualizar Vendas" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkVendasRealizar" 
                                              Content="Realizar Vendas" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkVendasCancelar" 
                                              Content="Cancelar Vendas" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkVendasDesconto" 
                                              Content="Aplicar Descontos" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkVendasDevolucao" 
                                              Content="Processar Devoluções" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Módulo: Clientes -->
                            <GroupBox Header="👥 Clientes" Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <CheckBox x:Name="chkClientesVisualizar" 
                                              Content="Visualizar Clientes" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkClientesCadastrar" 
                                              Content="Cadastrar Clientes" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkClientesEditar" 
                                              Content="Editar Clientes" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkClientesExcluir" 
                                              Content="Excluir Clientes" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>

                        <!-- Coluna 2 -->
                        <StackPanel Grid.Column="2">
                            <!-- Módulo: Financeiro -->
                            <GroupBox Header="💵 Financeiro" Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <CheckBox x:Name="chkFinanceiroVisualizar" 
                                              Content="Visualizar Financeiro" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkFinanceiroContas" 
                                              Content="Contas a Pagar/Receber" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkFinanceiroCaixa" 
                                              Content="Abrir/Fechar Caixa" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkFinanceiroRelatorios" 
                                              Content="Relatórios Financeiros" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Módulo: Relatórios -->
                            <GroupBox Header="📈 Relatórios" Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <CheckBox x:Name="chkRelatoriosVendas" 
                                              Content="Relatórios de Vendas" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkRelatoriosEstoque" 
                                              Content="Relatórios de Estoque" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkRelatoriosFinanceiro" 
                                              Content="Relatórios Financeiros" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkRelatoriosGerenciais" 
                                              Content="Relatórios Gerenciais" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkRelatoriosExportar" 
                                              Content="Exportar Relatórios" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>

                            <!-- Módulo: Sistema -->
                            <GroupBox Header="⚙️ Sistema" Style="{StaticResource ModernGroupBox}">
                                <StackPanel>
                                    <CheckBox x:Name="chkSistemaUsuarios" 
                                              Content="Gerenciar Usuários" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkSistemaPermissoes" 
                                              Content="Gerenciar Permissões" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkSistemaConfiguracoes" 
                                              Content="Configurações" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkSistemaBackup" 
                                              Content="Realizar Backup" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                    <CheckBox x:Name="chkSistemaLogs" 
                                              Content="Visualizar Logs" 
                                              Style="{StaticResource ModernCheckBox}"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Rodapé com Botões -->
        <Border Grid.Row="2" 
                Background="White" 
                BorderBrush="#E0E0E0" 
                BorderThickness="0,1,0,0">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="-2" Opacity="0.1" Color="#000000" Direction="90"/>
            </Border.Effect>

            <StackPanel Orientation="Horizontal" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center">
                <Button x:Name="btnSalvarPermissoes"
                        Content="💾 Salvar Permissões"
                        Style="{StaticResource SuccessButton}"
                        Click="BtnSalvarPermissoes_Click"
                        Padding="28,12"
                        FontSize="14"/>

                <Button x:Name="btnFechar"
                        Content="✖ Fechar"
                        Style="{StaticResource SecondaryButton}"
                        Click="BtnFechar_Click"
                        Padding="28,12"
                        FontSize="14"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>