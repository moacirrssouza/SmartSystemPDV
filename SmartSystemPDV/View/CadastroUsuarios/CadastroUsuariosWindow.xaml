<Window x:Class="SmartSystemPDV.View.CadastroUsuarios.CadastroUsuariosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.CadastroUsuarios"
        xmlns:conv="clr-namespace:SmartSystemPDV.Converters"
        mc:Ignorable="d"
        Title="Cadastro de Usuários" 
        Height="750" 
        Width="1400"
        MinHeight="700"
        MinWidth="1300"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <conv:StringToVisibilityConverter x:Key="StringToVisibilityConverter"/>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para PasswordBox -->
        <Style x:Key="ModernPasswordBox" TargetType="PasswordBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <!-- Estilo para Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←"
                            Command="{Binding VoltarCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="22"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Width="40"
                            Height="40"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A5D8A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="👥 Cadastro de Usuários" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding UsuarioLogado, StringFormat='Usuário: {0}'}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel de Cadastro -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Stretch">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dados do Usuário" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,16"/>

                        <!-- ID -->
                        <Label Content="ID:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtId" 
                                 Text="{Binding Id}"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 IsReadOnly="True"
                                 Background="#F8F9FA"/>

                        <!-- Nome Completo -->
                        <Label Content="Nome Completo:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtNome" 
                                 Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CamposHabilitados}"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 MaxLength="100"/>

                        <!-- Grid com 2 colunas -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Nome de Usuário -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Usuário (Login):*" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtUsuario" 
                                         Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CamposHabilitados}"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="50"/>
                            </StackPanel>

                            <!-- Cargo -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Cargo/Função:" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtCargo" 
                                         Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CamposHabilitados}"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="50"/>
                            </StackPanel>
                        </Grid>

                        <!-- Email -->
                        <Label Content="Email:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtEmail" 
                                 Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}"
                                 IsEnabled="{Binding CamposHabilitados}"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 MaxLength="100"/>

                        <!-- Senha -->
                        <Label Content="Senha:*" Style="{StaticResource ModernLabel}"/>
                        <Grid Margin="0,0,0,10">
                            <PasswordBox x:Name="txtSenha"
                                         Style="{StaticResource ModernPasswordBox}"
                                         PasswordChanged="TxtSenha_PasswordChanged"/>
                            <Button x:Name="btnMostrarSenha"
                                    Content="👁"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,2,0"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Foreground="#666666"
                                    FontSize="14"
                                    Cursor="Hand"
                                    Click="BtnMostrarSenha_Click"/>
                        </Grid>

                        <!-- Confirmar Senha -->
                        <Label Content="Confirmar Senha:*" Style="{StaticResource ModernLabel}"/>
                        <PasswordBox x:Name="txtConfirmarSenha"
                                     Style="{StaticResource ModernPasswordBox}"
                                     Margin="0,0,0,10"
                                     PasswordChanged="TxtConfirmarSenha_PasswordChanged"/>

                        <!-- Grid Departamento e Telefone -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Departamento -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Departamento:" Style="{StaticResource ModernLabel}"/>
                                <ComboBox x:Name="cbDepartamento" 
                                          Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Departamentos}"
                                          SelectedItem="{Binding DepartamentoSelecionado}"
                                          IsEnabled="{Binding CamposHabilitados}">
                                </ComboBox>
                            </StackPanel>

                            <!-- Telefone -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Telefone:" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtTelefone" 
                                         Text="{Binding Telefone, UpdateSourceTrigger=PropertyChanged}"
                                         IsEnabled="{Binding CamposHabilitados}"
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="15"/>
                            </StackPanel>
                        </Grid>

                        <!-- Grid Perfil e Status -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Perfil de Acesso -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Perfil:*" Style="{StaticResource ModernLabel}"/>
                                <ComboBox x:Name="cbPerfil" 
                                          Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding Perfis}"
                                          SelectedItem="{Binding PerfilSelecionado}"
                                          IsEnabled="{Binding CamposHabilitados}">
                                </ComboBox>
                            </StackPanel>

                            <!-- Status -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Status:" Style="{StaticResource ModernLabel}"/>
                                <ComboBox x:Name="cbStatus" 
                                          Style="{StaticResource ModernComboBox}"
                                          ItemsSource="{Binding StatusOptions}"
                                          SelectedItem="{Binding StatusSelecionado}"
                                          IsEnabled="{Binding CamposHabilitados}">
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Descrição do Perfil -->
                        <Border Background="#E3F2FD" 
                                Padding="10" 
                                CornerRadius="4"
                                Margin="0,0,0,16"
                                Visibility="{Binding ElementName=txtDescricaoPerfil, Path=Text, Converter={StaticResource StringToVisibilityConverter}}">
                            <TextBlock x:Name="txtDescricaoPerfil"
                                       Text="{Binding DescricaoPerfil}"
                                       TextWrapping="Wrap"
                                       FontSize="11"
                                       Foreground="#1565C0"/>
                        </Border>

                        <TextBlock Text="* Campos obrigatórios" 
                                   FontSize="10"
                                   Foreground="#999999"
                                   FontStyle="Italic"
                                   Margin="0,0,0,16"/>

                        <!-- Botões de Ação -->
                        <StackPanel>
                            <Button x:Name="btnNovo"
                                    Content="🆕 Novo Usuário"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,0"
                                    Command="{Binding NovoCommand}"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="btnSalvar"
                                        Grid.Column="0"
                                        Content="💾 Salvar"
                                        Style="{StaticResource SuccessButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,4,0"
                                        Command="{Binding SalvarCommand}"
                                        IsEnabled="{Binding CamposHabilitados}"/>

                                <Button x:Name="btnCancelar"
                                        Grid.Column="1"
                                        Content="✖ Cancelar"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="4,0,0,0"
                                        Command="{Binding CancelarCommand}"
                                        IsEnabled="{Binding CamposHabilitados}"/>
                            </Grid>
                        </StackPanel>

                        <Rectangle Height="1" 
                                  Fill="#E0E0E0"
                                  Margin="0,20,0,20"/>

                        <!-- Botão Gerenciar Permissões -->
                        <Button x:Name="btnGerenciarPermissoes"
                                Content="🔐 Gerenciar Permissões"
                                Style="{StaticResource WarningButton}"
                                HorizontalAlignment="Stretch"
                                Margin="0"
                                Command="{Binding GerenciarPermissoesCommand}"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Painel de Lista de Usuários -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}"
                    Margin="10,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <TextBlock Grid.Row="0"
                               Text="📋 Lista de Usuários Cadastrados" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#1A4D7A"
                               Margin="0,0,0,16"/>

                    <!-- Barra de Pesquisa e Filtros -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="140"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="txtPesquisa"
                                     Style="{StaticResource ModernTextBox}"
                                     Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}"/>

                            <TextBlock IsHitTestVisible="False"
                                       Text="🔍 Pesquisar por nome, usuário ou email..."
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="12,0,0,0"
                                       Foreground="#999999"
                                       FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtPesquisa}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <ComboBox Grid.Column="1"
                                  x:Name="cbFiltroPerfil"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,8,0"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding FiltroPerfil}">
                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                            <ComboBoxItem Content="Administrador"/>
                            <ComboBoxItem Content="Gerente"/>
                            <ComboBoxItem Content="Vendedor"/>
                            <ComboBoxItem Content="Estoquista"/>
                            <ComboBoxItem Content="Operador"/>
                        </ComboBox>

                        <ComboBox Grid.Column="2"
                                  x:Name="cbFiltroStatus"
                                  Style="{StaticResource ModernComboBox}"
                                  SelectedValuePath="Content"
                                  SelectedValue="{Binding FiltroStatus}">
                            <ComboBoxItem Content="Todos" IsSelected="True"/>
                            <ComboBoxItem Content="Ativo"/>
                            <ComboBoxItem Content="Inativo"/>
                            <ComboBoxItem Content="Bloqueado"/>
                        </ComboBox>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              x:Name="dgUsuarios"
                              Style="{StaticResource ModernDataGrid}"
                              ItemsSource="{Binding ListaUsuarios}"
                              SelectedItem="{Binding UsuarioSelecionadoGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="50"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" MinWidth="150"/>
                            <DataGridTextColumn Header="Usuário" Binding="{Binding Login}" Width="110"/>
                            <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Perfil" Binding="{Binding Perfil}" Width="110"/>
                            <DataGridTextColumn Header="Departamento" Binding="{Binding Departamento}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding StatusTexto}" Width="85"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding StatusTexto}" Value="Bloqueado">
                                        <Setter Property="Background" Value="#FFEBEE"/>
                                        <Setter Property="Foreground" Value="#C62828"/>
                                        <Setter Property="FontWeight" Value="SemiBold"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding StatusTexto}" Value="Inativo">
                                        <Setter Property="Foreground" Value="#999999"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Rodapé com ações -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="txtTotalUsuarios"
                                   Text="{Binding TotalUsuariosTexto}"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#666666"/>

                        <StackPanel Grid.Column="2" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Right">
                            <Button x:Name="btnEditar"
                                    Content="✏️ Editar"
                                    Style="{StaticResource PrimaryButton}"
                                    Width="100"
                                    Command="{Binding EditarCommand}"/>

                            <Button x:Name="btnResetarSenha"
                                    Content="🔑 Resetar"
                                    Style="{StaticResource WarningButton}"
                                    Width="100"
                                    Command="{Binding ResetarSenhaCommand}"/>

                            <Button x:Name="btnExcluir"
                                    Content="🗑️ Excluir"
                                    Style="{StaticResource DangerButton}"
                                    Width="100"
                                    Command="{Binding ExcluirCommand}"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
