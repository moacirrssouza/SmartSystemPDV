<Window x:Class="SmartSystemPDV.View.Caixa.FinalizarVendaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.Caixa"
        mc:Ignorable="d"
        Title="Finalizar Venda" 
        Height="750" 
        Width="900"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        WindowStyle="SingleBorderWindow">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Height" Value="50"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Botão de Forma de Pagamento -->
        <Style x:Key="PaymentButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Height" Value="100"/>
            <Setter Property="MinWidth" Value="180"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8"
                                Padding="12">
                            <ContentPresenter HorizontalAlignment="Stretch" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F0F8FF"/>
                    <Setter Property="BorderBrush" Value="#1A4D7A"/>
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#E0F0FF"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Height" Value="60"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid Margin="20,0">
                <TextBlock Text="💳 Finalizar Venda - Pagamento" 
                           FontSize="20" 
                           FontWeight="Bold" 
                           Foreground="White"
                           VerticalAlignment="Center"/>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center">
                    <TextBlock Text="Total:" 
                               Foreground="White" 
                               FontSize="14"
                               FontWeight="SemiBold"
                               Margin="0,0,10,0"/>
                    <TextBlock Text="{Binding TotalVenda, StringFormat='R$ {0:N2}'}" 
                               Foreground="#FFD700" 
                               FontSize="22"
                               FontWeight="Bold"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="400"/>
            </Grid.ColumnDefinitions>

            <!-- Painel Esquerdo - Formas de Pagamento -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="💰 Selecione a Forma de Pagamento" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#1A4D7A"
                               Margin="0,0,0,20"/>

                    <!-- Botões de Formas de Pagamento -->
                    <UniformGrid Grid.Row="1" 
                                 Columns="2" 
                                 Rows="3"
                                 Margin="0,0,0,20">
                        <Button Style="{StaticResource PaymentButton}"
                                Command="{Binding SelecionarFormaPagamentoCommand}"
                                CommandParameter="Dinheiro">
                            <StackPanel>
                                <TextBlock Text="💵" FontSize="28" Margin="0,0,0,5"/>
                                <TextBlock Text="Dinheiro" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PaymentButton}"
                                Command="{Binding SelecionarFormaPagamentoCommand}"
                                CommandParameter="Débito">
                            <StackPanel>
                                <TextBlock Text="💳" FontSize="28" Margin="0,0,0,5"/>
                                <TextBlock Text="Cartão Débito" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PaymentButton}"
                                Command="{Binding SelecionarFormaPagamentoCommand}"
                                CommandParameter="Crédito">
                            <StackPanel>
                                <TextBlock Text="💳" FontSize="28" Margin="0,0,0,5"/>
                                <TextBlock Text="Cartão Crédito" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PaymentButton}"
                                Command="{Binding SelecionarFormaPagamentoCommand}"
                                CommandParameter="Pix">
                            <StackPanel>
                                <TextBlock Text="📱" FontSize="28" Margin="0,0,0,5"/>
                                <TextBlock Text="PIX" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PaymentButton}"
                                Command="{Binding SelecionarFormaPagamentoCommand}"
                                CommandParameter="Boleto">
                            <StackPanel>
                                <TextBlock Text="📄" FontSize="28" Margin="0,0,0,5"/>
                                <TextBlock Text="Boleto" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/>
                            </StackPanel>
                        </Button>

                        <Button Style="{StaticResource PaymentButton}"
                                Command="{Binding SelecionarFormaPagamentoCommand}"
                                CommandParameter="Crediário">
                            <StackPanel>
                                <TextBlock Text="📋" FontSize="28" Margin="0,0,0,5"/>
                                <TextBlock Text="Crediário" FontSize="14" FontWeight="Bold" TextWrapping="Wrap" TextAlignment="Center" TextTrimming="None"/>
                            </StackPanel>
                        </Button>
                    </UniformGrid>

                    <!-- Lista de Pagamentos Adicionados -->
                    <Grid Grid.Row="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="📝 Pagamentos Adicionados" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,10"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding PagamentosAdicionados}"
                                  SelectedItem="{Binding PagamentoSelecionado}"
                                  Style="{StaticResource ModernDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Forma" Binding="{Binding FormaPagamento}" Width="*"/>
                                <DataGridTextColumn Header="Valor" Binding="{Binding Valor, StringFormat='R$ {0:N2}'}" Width="120">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="FontWeight" Value="Bold"/>
                                            <Setter Property="Foreground" Value="#1A4D7A"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTemplateColumn Header="Ação" Width="80">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="🗑️" 
                                                    Command="{Binding DataContext.RemoverPagamentoCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Background="Transparent"
                                                    BorderThickness="0"
                                                    Cursor="Hand"
                                                    FontSize="16"
                                                    ToolTip="Remover"/>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>
            </Border>

            <!-- Painel Direito - Resumo e Confirmação -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Valor do Pagamento Atual -->
                <Border Grid.Row="0" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,10"
                        Visibility="{Binding MostrarPainelPagamento}">
                    <StackPanel>
                        <TextBlock Text="{Binding FormaPagamentoSelecionada, StringFormat='💳 {0}'}" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,10"/>

                        <Label Content="Valor a Pagar:" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding ValorPagamentoAtual, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Margin="0,0,0,10">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Return" Command="{Binding AdicionarPagamentoCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <Button Content="➕ Adicionar Pagamento"
                                Command="{Binding AdicionarPagamentoCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Height="45"/>
                    </StackPanel>
                </Border>

                <!-- Resumo Financeiro -->
                <Border Grid.Row="1" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,10"
                        Background="#F8F9FA">
                    <StackPanel>
                        <TextBlock Text="📊 Resumo do Pagamento" 
                                   FontSize="14" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,15"/>

                        <!-- Total da Venda -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Total da Venda:" 
                                       FontSize="14"
                                       Foreground="#666666"/>
                            <TextBlock Text="{Binding TotalVenda, StringFormat='R$ {0:N2}'}" 
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Foreground="#333333"/>
                        </Grid>

                        <!-- Total Pago -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock Text="Total Pago:" 
                                       FontSize="14"
                                       Foreground="#666666"/>
                            <TextBlock Text="{Binding TotalPago, StringFormat='R$ {0:N2}'}" 
                                       FontSize="14"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right"
                                       Foreground="#1A4D7A"/>
                        </Grid>

                        <Separator Margin="0,5" Background="#DDDDDD"/>

                        <!-- Restante ou Troco -->
                        <Grid Margin="0,10,0,0">
                            <TextBlock Text="{Binding LabelRestanteTroco}" 
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="#1A4D7A"/>
                            <TextBlock Text="{Binding ValorRestanteTroco, StringFormat='R$ {0:N2}'}" 
                                       FontSize="28"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Right">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#DC3545"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TemTroco}" Value="True">
                                                <Setter Property="Foreground" Value="#28A745"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Observações -->
                <Border Grid.Row="2" 
                        Style="{StaticResource CardStyle}"
                        Margin="0,0,0,10">
                    <StackPanel>
                        <Label Content="📝 Observações:" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding Observacoes, UpdateSourceTrigger=PropertyChanged}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="100"
                                 VerticalScrollBarVisibility="Auto"
                                 Style="{StaticResource ModernTextBox}"/>
                    </StackPanel>
                </Border>

                <!-- Botões de Ação -->
                <StackPanel Grid.Row="3">
                    <Button Content="✅ CONFIRMAR VENDA"
                            Command="{Binding ConfirmarVendaCommand}"
                            Style="{StaticResource SuccessButton}"
                            IsEnabled="{Binding PodeConfirmarVenda}"
                            Margin="0,0,0,8"/>

                    <Button Content="❌ Cancelar"
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource DangerButton}"
                            Height="45"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Window>
