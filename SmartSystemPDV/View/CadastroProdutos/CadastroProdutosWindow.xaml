<Window x:Class="SmartSystemPDV.View.CadastroProdutos.CadastroProdutosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.CadastroProdutos"
        mc:Ignorable="d"
        Title="DataPlace - Cadastro de Produtos" 
        Height="700" 
        Width="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="10"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="35"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,10"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="None"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="35"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <Button Content="←" 
                            Click="BtnVoltar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="24"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Padding="10,0"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#33FFFFFF"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="📦 Cadastro de Produtos" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="10,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ElementName=txtUsuarioLogado, Path=Text, FallbackValue='Usuário: Admin'}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Margin="20,0"
                           Foreground="White"
                           FontSize="14"/>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Background="#F5F5F5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="400"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel de Cadastro -->
            <Border Grid.Column="0" 
                    Background="White" 
                    Margin="15"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20">
                        <TextBlock Text="Dados do Produto" 
                                   FontSize="18" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,20"/>

                        <!-- Código -->
                        <Label Content="Código:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtCodigo" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,15"
                                 IsReadOnly="True"
                                 Background="#F0F0F0"/>

                        <!-- Nome do Produto -->
                        <Label Content="Nome do Produto:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtNome" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,15"
                                 MaxLength="100"/>

                        <!-- Descrição -->
                        <Label Content="Descrição:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtDescricao" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="80"
                                 Padding="10"
                                 FontSize="14"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,15"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- Categoria -->
                        <Label Content="Categoria:*" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbCategoria" 
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,15">
                            <ComboBoxItem Content="Selecione..." IsSelected="True"/>
                            <ComboBoxItem Content="Eletrônicos"/>
                            <ComboBoxItem Content="Alimentos"/>
                            <ComboBoxItem Content="Bebidas"/>
                            <ComboBoxItem Content="Limpeza"/>
                            <ComboBoxItem Content="Higiene"/>
                            <ComboBoxItem Content="Vestuário"/>
                            <ComboBoxItem Content="Outros"/>
                        </ComboBox>

                        <!-- Unidade de Medida -->
                        <Label Content="Unidade de Medida:*" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbUnidade" 
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,15">
                            <ComboBoxItem Content="Selecione..." IsSelected="True"/>
                            <ComboBoxItem Content="UN (Unidade)"/>
                            <ComboBoxItem Content="KG (Quilograma)"/>
                            <ComboBoxItem Content="LT (Litro)"/>
                            <ComboBoxItem Content="MT (Metro)"/>
                            <ComboBoxItem Content="CX (Caixa)"/>
                            <ComboBoxItem Content="PC (Pacote)"/>
                        </ComboBox>

                        <!-- Preço de Custo -->
                        <Label Content="Preço de Custo (R$):*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtPrecoCusto" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,15"
                                 PreviewTextInput="TextBox_PreviewTextInput"/>

                        <!-- Preço de Venda -->
                        <Label Content="Preço de Venda (R$):*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtPrecoVenda" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,15"
                                 PreviewTextInput="TextBox_PreviewTextInput"/>

                        <!-- Estoque Atual -->
                        <Label Content="Estoque Atual:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtEstoque" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,15"
                                 PreviewTextInput="TextBox_PreviewTextInputNumeric"/>

                        <!-- Estoque Mínimo -->
                        <Label Content="Estoque Mínimo:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtEstoqueMinimo" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,15"
                                 PreviewTextInput="TextBox_PreviewTextInputNumeric"/>

                        <!-- Status -->
                        <Label Content="Status:" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbStatus" 
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,20">
                            <ComboBoxItem Content="Ativo" IsSelected="True"/>
                            <ComboBoxItem Content="Inativo"/>
                        </ComboBox>

                        <TextBlock Text="* Campos obrigatórios" 
                                   FontSize="11"
                                   Foreground="#666666"
                                   FontStyle="Italic"
                                   Margin="0,0,0,15"/>

                        <!-- Botões de Ação -->
                        <StackPanel Orientation="Horizontal" 
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,0">
                            <Button x:Name="btnNovo"
                                    Content="🆕 Novo"
                                    Style="{StaticResource PrimaryButton}"
                                    Click="BtnNovo_Click"/>

                            <Button x:Name="btnSalvar"
                                    Content="💾 Salvar"
                                    Style="{StaticResource SuccessButton}"
                                    Click="BtnSalvar_Click"/>

                            <Button x:Name="btnCancelar"
                                    Content="✖ Cancelar"
                                    Style="{StaticResource SecondaryButton}"
                                    Click="BtnCancelar_Click"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Painel de Lista de Produtos -->
            <Border Grid.Column="1" 
                    Background="White" 
                    Margin="15,15,15,15"
                    CornerRadius="10"
                    BorderBrush="#DDDDDD"
                    BorderThickness="1">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="2" Opacity="0.2"/>
                </Border.Effect>

                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <TextBlock Grid.Row="0"
                               Text="Lista de Produtos" 
                               FontSize="18" 
                               FontWeight="Bold"
                               Foreground="#1A4D7A"
                               Margin="0,0,0,15"/>

                    <!-- Barra de Pesquisa -->
                    <Grid Grid.Row="1" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBox x:Name="txtPesquisa"
                                 Grid.Column="0"
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,10,0"
                                 TextChanged="TxtPesquisa_TextChanged">
                            <TextBox.InputBindings>
                                <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                            </TextBox.InputBindings>
                        </TextBox>

                        <TextBlock Grid.Column="0"
                                   IsHitTestVisible="False"
                                   Text="🔍 Pesquisar produto..."
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Left"
                                   Margin="15,0,0,0"
                                   Foreground="#999999"
                                   FontSize="14">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Text, ElementName=txtPesquisa}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <Button Grid.Column="1"
                                Content="🔍 Pesquisar"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0"
                                Click="BtnPesquisar_Click"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              x:Name="dgProdutos"
                              Style="{StaticResource ModernDataGrid}"
                              SelectionChanged="DgProdutos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="80"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="120"/>
                            <DataGridTextColumn Header="Unidade" Binding="{Binding Unidade}" Width="80"/>
                            <DataGridTextColumn Header="Preço Custo" Binding="{Binding PrecoCusto, StringFormat=C2}" Width="110"/>
                            <DataGridTextColumn Header="Preço Venda" Binding="{Binding PrecoVenda, StringFormat=C2}" Width="110"/>
                            <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="80"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rodapé com ações -->
                    <StackPanel Grid.Row="3" 
                               Orientation="Horizontal" 
                               HorizontalAlignment="Right"
                               Margin="0,15,0,0">
                        <Button x:Name="btnEditar"
                                Content="✏ Editar"
                                Style="{StaticResource PrimaryButton}"
                                Click="BtnEditar_Click"
                                IsEnabled="False"/>

                        <Button x:Name="btnExcluir"
                                Content="🗑 Excluir"
                                Style="{StaticResource DangerButton}"
                                Click="BtnExcluir_Click"
                                IsEnabled="False"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>