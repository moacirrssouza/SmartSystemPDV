<Window x:Class="SmartSystemPDV.View.CadastroProdutos.CadastroProdutosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.CadastroProdutos"
        mc:Ignorable="d"
        Title="Cadastro de Produtos" 
        Height="800" 
        Width="1600"
        MinHeight="700"
        MinWidth="1400"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DatePicker -->
        <Style x:Key="ModernDatePicker" TargetType="DatePicker">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#333333"/>

            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#E5E5E5"/>
                    <Setter Property="Foreground" Value="#888888"/>
                    <Setter Property="BorderBrush" Value="#B0B0B0"/>
                </Trigger>
            </Style.Triggers>
        </Style>


        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para botões de paginação -->
        <Style x:Key="PaginationButton" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="#1A4D7A"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Margin" Value="2,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E8F4F8"/>
                    <Setter Property="BorderBrush" Value="#1A4D7A"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#F5F5F5"/>
                    <Setter Property="Foreground" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <!-- Estilo para Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" 
                            Command="{Binding VoltarCommand}"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="22"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Width="40"
                            Height="40"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A5D8A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="📦 Cadastro de Produtos" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding UsuarioLogado, StringFormat='Usuário: {0}'}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="480"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel de Cadastro -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Stretch">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel IsEnabled="{Binding CamposHabilitados}">
                        <TextBlock Text="Dados do Produto" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,16"/>

                        <!-- Código -->
                        <Label Content="Código:" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding Codigo}" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 IsReadOnly="True"
                                 Background="#F8F9FA"/>

                        <!-- Nome do Produto -->
                        <Label Content="Nome do Produto:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding Nome, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 MaxLength="100"/>

                        <!-- Descrição -->
                        <Label Content="Descrição:" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding Descricao, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource ModernTextBox}"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="60"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,0,10"/>

                        <!-- Código de Barras -->
                        <Label Content="Código de Barras:" Style="{StaticResource ModernLabel}"/>
                        <TextBox Text="{Binding CodigoBarras, UpdateSourceTrigger=PropertyChanged}" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 MaxLength="50"/>

                        <!-- Grid com Lote e Datas -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Lote -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Lote:" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding Lote, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"
                                         MaxLength="30"/>
                            </StackPanel>

                            <!-- Data de Fabricação -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Data Fabricação:" Style="{StaticResource ModernLabel}"/>
                                <DatePicker SelectedDate="{Binding DataFabricacao}" 
                                           Style="{StaticResource ModernDatePicker}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Data de Vencimento -->
                        <Label Content="Data de Vencimento:" Style="{StaticResource ModernLabel}"/>
                        <DatePicker SelectedDate="{Binding DataVencimento}" 
                                   Style="{StaticResource ModernDatePicker}"
                                   Margin="0,0,0,10"/>

                        <!-- Grid com 2 colunas -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Categoria -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Categoria:*" Style="{StaticResource ModernLabel}"/>
                                <ComboBox ItemsSource="{Binding DataContext.Categorias, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding CategoriaSelecionada}"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>

                            <!-- Unidade de Medida -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Unidade:*" Style="{StaticResource ModernLabel}"/>
                                <ComboBox ItemsSource="{Binding DataContext.Unidades, RelativeSource={RelativeSource AncestorType=Window}}"
                                          SelectedItem="{Binding UnidadeSelecionada}"
                                          Style="{StaticResource ModernComboBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Grid com Preços -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="Preço Custo (R$):" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding PrecoCusto, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="Preço Venda (R$):" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding PrecoVenda, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Grid com Estoque -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <Label Content="Estoque Atual:" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding Estoque, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Label Content="Estoque Mínimo:" Style="{StaticResource ModernLabel}"/>
                                <TextBox Text="{Binding EstoqueMinimo, UpdateSourceTrigger=PropertyChanged}" 
                                         Style="{StaticResource ModernTextBox}"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <Label Content="Status:" Style="{StaticResource ModernLabel}"/>
                        <ComboBox ItemsSource="{Binding DataContext.StatusOptions, RelativeSource={RelativeSource AncestorType=Window}}"
                                  SelectedItem="{Binding StatusSelecionado}"
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,20"/>

                        <!-- Botões de Ação -->
                        <StackPanel>
                            <!-- Note: Actions are enabled/disabled by the ViewModel command logic or CamposHabilitados -->
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
            
            <!-- Botões flutuantes fora do ScrollViewer para estarem sempre visíveis -->
             <StackPanel Grid.Column="0" VerticalAlignment="Bottom" Margin="20,0,30,20">
                 <!-- Botão Novo (sempre habilitado se não estiver editando? ViewModel controla) -->
                 <Button Content="🆕 Novo Produto"
                        Command="{Binding NovoCommand}"
                        Style="{StaticResource PrimaryButton}"
                        HorizontalAlignment="Stretch"
                        Margin="0,0,0,5"/>

                 <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0"
                            Content="{Binding BotaoSalvarTexto}"
                            Command="{Binding SalvarCommand}"
                            Style="{StaticResource SuccessButton}"
                            HorizontalAlignment="Stretch"
                            Margin="0,0,4,0"/>

                    <Button Grid.Column="1"
                            Content="❌ Cancelar"
                            Command="{Binding CancelarCommand}"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Stretch"
                            Margin="4,0,0,0"/>
                </Grid>
            </StackPanel>

            <!-- Lista de Produtos -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}"
                    Margin="10,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Barra de Pesquisa e Ações -->
                    <Grid Grid.Row="0" Margin="0,0,0,15">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Pesquisa -->
                        <Grid Grid.Column="0" Margin="0,0,10,0">
                            <TextBox Text="{Binding TextoPesquisa, UpdateSourceTrigger=PropertyChanged}"
                                     Style="{StaticResource ModernTextBox}"
                                     Padding="10,0,35,0"
                                     VerticalContentAlignment="Center"/>
                            <TextBlock Text="🔍" 
                                       HorizontalAlignment="Right" 
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="#888888"
                                       IsHitTestVisible="False"/>
                            <TextBlock Text="Pesquisar..." 
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Margin="12,0,0,0"
                                       Foreground="#AAAAAA">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding TextoPesquisa}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                                Content="🔍 Buscar"
                                Command="{Binding PesquisarCommand}"
                                Style="{StaticResource PrimaryButton}"
                                Margin="0,0,5,0"
                                Width="80"/>

                        <Button Grid.Column="2"
                                Content="✏️ Editar"
                                Command="{Binding EditarCommand}"
                                Style="{StaticResource WarningButton}"
                                Margin="0,0,5,0"
                                Width="80"/>

                        <Button Grid.Column="3"
                                Content="🗑️ Excluir"
                                Command="{Binding ExcluirCommand}"
                                Style="{StaticResource DangerButton}"
                                Width="90"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="1" 
                              ItemsSource="{Binding ListaProdutos}"
                              SelectedItem="{Binding ProdutoSelecionadoGrid}"
                              Style="{StaticResource ModernDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Cód" Binding="{Binding Codigo}" Width="60"/>
                            <DataGridTextColumn Header="Produto" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="120"/>
                            <DataGridTextColumn Header="Und" Binding="{Binding Unidade}" Width="50"/>
                            <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="80"/>
                            <DataGridTextColumn Header="Preço Venda" Binding="{Binding PrecoVenda, StringFormat='R$ {0:N2}'}" Width="100"/>
                            <DataGridTemplateColumn Header="Status" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Center">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E0E0E0"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Status}" Value="Ativo">
                                                            <Setter Property="Background" Value="#D4EDDA"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                            <Setter Property="Background" Value="#F8D7DA"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Status}" FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="#555555"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Ativo">
                                                                <Setter Property="Foreground" Value="#155724"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                                                <Setter Property="Foreground" Value="#721C24"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Rodapé / Paginação -->
                    <Grid Grid.Row="2" Margin="0,15,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Itens por página:" 
                                       VerticalAlignment="Center" 
                                       Foreground="#666666"
                                       Margin="0,0,10,0"/>
                            <ComboBox ItemsSource="{Binding ItensPorPaginaOptions}"
                                      SelectedItem="{Binding ItensPorPagina}"
                                      Width="60"
                                      Height="28"
                                      Style="{StaticResource ModernComboBox}"/>
                            
                            <TextBlock Text="{Binding TotalProdutosTexto}"
                                       VerticalAlignment="Center"
                                       Foreground="#666666"
                                       Margin="20,0,0,0"
                                       FontWeight="SemiBold"/>
                        </StackPanel>

                        <TextBlock Grid.Column="1" 
                                   Text="{Binding InfoPaginacao}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#666666"/>

                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Content="«" 
                                    Command="{Binding PrimeiraPaginaCommand}"
                                    Style="{StaticResource PaginationButton}"
                                    ToolTip="Primeira Página"/>
                            
                            <Button Content="‹" 
                                    Command="{Binding PaginaAnteriorCommand}"
                                    Style="{StaticResource PaginationButton}"
                                    ToolTip="Página Anterior"/>

                            <!-- Números de página - ItemsControl binding -->
                            <ItemsControl ItemsSource="{Binding NumerosPagina}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding}"
                                                Command="{Binding DataContext.IrParaPaginaCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                CommandParameter="{Binding}"
                                                Style="{StaticResource PaginationButton}">
                                            <!-- Simple trigger for Active state simulation - 
                                                 Real active state would require a converter or MultiBinding 
                                                 checking against PaginaAtual -->
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Button Content="›" 
                                    Command="{Binding ProximaPaginaCommand}"
                                    Style="{StaticResource PaginationButton}"
                                    ToolTip="Próxima Página"/>
                            
                            <Button Content="»" 
                                    Command="{Binding UltimaPaginaCommand}"
                                    Style="{StaticResource PaginationButton}"
                                    ToolTip="Última Página"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
