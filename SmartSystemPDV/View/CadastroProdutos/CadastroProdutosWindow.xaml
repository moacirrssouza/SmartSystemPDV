<Window x:Class="SmartSystemPDV.View.CadastroProdutos.CadastroProdutosWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SmartSystemPDV.View.CadastroProdutos"
        mc:Ignorable="d"
        Title="Cadastro de Produtos" 
        Height="750" 
        Width="1400"
        MinHeight="650"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <!-- Estilo para TextBox -->
        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para ComboBox -->
        <Style x:Key="ModernComboBox" TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para Label -->
        <Style x:Key="ModernLabel" TargetType="Label">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Setter Property="Padding" Value="0,0,0,4"/>
        </Style>

        <!-- Estilo para botões -->
        <Style x:Key="PrimaryButton" TargetType="Button">
            <Setter Property="Background" Value="#1A4D7A"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="16,8"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#2563A8"/>
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="#CCCCCC"/>
                    <Setter Property="Cursor" Value="Arrow"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SuccessButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#28A745"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#218838"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#DC3545"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#6C757D"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#5A6268"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="WarningButton" TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
            <Setter Property="Background" Value="#FFC107"/>
            <Setter Property="Foreground" Value="#333333"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E0A800"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para DataGrid -->
        <Style x:Key="ModernDataGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="AlternatingRowBackground" Value="#F9F9F9"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="BorderBrush" Value="#DDDDDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="RowHeight" Value="32"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#EEEEEE"/>
        </Style>

        <!-- Estilo para Cards -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid Margin="20,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="←" 
                            Click="BtnVoltar_Click"
                            Background="Transparent"
                            Foreground="White"
                            BorderThickness="0"
                            FontSize="22"
                            FontWeight="Bold"
                            Cursor="Hand"
                            Width="40"
                            Height="40"
                            ToolTip="Voltar">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="4">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#2A5D8A"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>

                    <TextBlock Text="📦 Cadastro de Produtos" 
                               FontSize="22" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"
                               Margin="12,0,0,0"/>
                </StackPanel>

                <TextBlock Text="{Binding ElementName=txtUsuarioLogado, Path=Text, FallbackValue='Usuário: Admin'}"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           Foreground="White"
                           FontSize="13"
                           Opacity="0.9"/>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Painel de Cadastro -->
            <Border Grid.Column="0" 
                    Style="{StaticResource CardStyle}"
                    Margin="0,0,10,0"
                    VerticalAlignment="Stretch">

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Dados do Produto" 
                                   FontSize="16" 
                                   FontWeight="Bold"
                                   Foreground="#1A4D7A"
                                   Margin="0,0,0,16"/>

                        <!-- Código -->
                        <Label Content="Código:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtCodigo" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 IsReadOnly="True"
                                 Background="#F8F9FA"/>

                        <!-- Nome do Produto -->
                        <Label Content="Nome do Produto:*" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtNome" 
                                 Style="{StaticResource ModernTextBox}"
                                 Margin="0,0,0,10"
                                 MaxLength="100"/>

                        <!-- Descrição -->
                        <Label Content="Descrição:" Style="{StaticResource ModernLabel}"/>
                        <TextBox x:Name="txtDescricao" 
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Height="60"
                                 Padding="10"
                                 FontSize="13"
                                 BorderBrush="#CCCCCC"
                                 BorderThickness="1"
                                 Margin="0,0,0,10"
                                 VerticalScrollBarVisibility="Auto"/>

                        <!-- Grid com 2 colunas -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Categoria -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Categoria:*" Style="{StaticResource ModernLabel}"/>
                                <ComboBox x:Name="cbCategoria" 
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Selecione..." IsSelected="True"/>
                                    <ComboBoxItem Content="Eletrônicos"/>
                                    <ComboBoxItem Content="Alimentos"/>
                                    <ComboBoxItem Content="Bebidas"/>
                                    <ComboBoxItem Content="Limpeza"/>
                                    <ComboBoxItem Content="Higiene"/>
                                    <ComboBoxItem Content="Vestuário"/>
                                    <ComboBoxItem Content="Outros"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Unidade de Medida -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Unidade:*" Style="{StaticResource ModernLabel}"/>
                                <ComboBox x:Name="cbUnidade" 
                                          Style="{StaticResource ModernComboBox}">
                                    <ComboBoxItem Content="Selecione..." IsSelected="True"/>
                                    <ComboBoxItem Content="UN"/>
                                    <ComboBoxItem Content="KG"/>
                                    <ComboBoxItem Content="LT"/>
                                    <ComboBoxItem Content="MT"/>
                                    <ComboBoxItem Content="CX"/>
                                    <ComboBoxItem Content="PC"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Grid com Preços -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Preço de Custo -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Preço Custo (R$):*" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtPrecoCusto" 
                                         Style="{StaticResource ModernTextBox}"
                                         PreviewTextInput="TextBox_PreviewTextInput"/>
                            </StackPanel>

                            <!-- Preço de Venda -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Preço Venda (R$):*" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtPrecoVenda" 
                                         Style="{StaticResource ModernTextBox}"
                                         PreviewTextInput="TextBox_PreviewTextInput"/>
                            </StackPanel>
                        </Grid>

                        <!-- Grid com Estoques -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Estoque Atual -->
                            <StackPanel Grid.Column="0">
                                <Label Content="Estoque Atual:*" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtEstoque" 
                                         Style="{StaticResource ModernTextBox}"
                                         PreviewTextInput="TextBox_PreviewTextInputNumeric"/>
                            </StackPanel>

                            <!-- Estoque Mínimo -->
                            <StackPanel Grid.Column="2">
                                <Label Content="Estoque Mínimo:" Style="{StaticResource ModernLabel}"/>
                                <TextBox x:Name="txtEstoqueMinimo" 
                                         Style="{StaticResource ModernTextBox}"
                                         PreviewTextInput="TextBox_PreviewTextInputNumeric"/>
                            </StackPanel>
                        </Grid>

                        <!-- Status -->
                        <Label Content="Status:" Style="{StaticResource ModernLabel}"/>
                        <ComboBox x:Name="cbStatus" 
                                  Style="{StaticResource ModernComboBox}"
                                  Margin="0,0,0,16">
                            <ComboBoxItem Content="Ativo" IsSelected="True"/>
                            <ComboBoxItem Content="Inativo"/>
                        </ComboBox>

                        <TextBlock Text="* Campos obrigatórios" 
                                   FontSize="10"
                                   Foreground="#999999"
                                   FontStyle="Italic"
                                   Margin="0,0,0,16"/>

                        <!-- Botões de Ação -->
                        <StackPanel>
                            <Button x:Name="btnNovo"
                                    Content="🆕 Novo Produto"
                                    Style="{StaticResource PrimaryButton}"
                                    HorizontalAlignment="Stretch"
                                    Margin="0,0,0,0"
                                    Click="BtnNovo_Click"/>

                            <Grid Margin="0,0,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Button x:Name="btnSalvar"
                                        Grid.Column="0"
                                        Content="💾 Salvar"
                                        Style="{StaticResource SuccessButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="0,0,4,0"
                                        Click="BtnSalvar_Click"/>

                                <Button x:Name="btnCancelar"
                                        Grid.Column="1"
                                        Content="✖ Cancelar"
                                        Style="{StaticResource SecondaryButton}"
                                        HorizontalAlignment="Stretch"
                                        Margin="4,0,0,0"
                                        Click="BtnCancelar_Click"/>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- Painel de Lista de Produtos -->
            <Border Grid.Column="1" 
                    Style="{StaticResource CardStyle}"
                    Margin="10,0,0,0">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Título -->
                    <TextBlock Grid.Row="0"
                               Text="📋 Lista de Produtos Cadastrados" 
                               FontSize="16" 
                               FontWeight="Bold"
                               Foreground="#1A4D7A"
                               Margin="0,0,0,16"/>

                    <!-- Barra de Pesquisa -->
                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <Grid Grid.Column="0" Margin="0,0,8,0">
                            <TextBox x:Name="txtPesquisa"
                                     Style="{StaticResource ModernTextBox}"
                                     TextChanged="TxtPesquisa_TextChanged">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>

                            <TextBlock IsHitTestVisible="False"
                                       Text="🔍 Pesquisar por nome, código ou categoria..."
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Left"
                                       Margin="12,0,0,0"
                                       Foreground="#999999"
                                       FontSize="13">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Text, ElementName=txtPesquisa}" Value="">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>

                        <Button Grid.Column="1"
                                Content="🔍 Pesquisar"
                                Style="{StaticResource PrimaryButton}"
                                Width="110"
                                Margin="0"
                                Click="BtnPesquisar_Click"/>
                    </Grid>

                    <!-- DataGrid -->
                    <DataGrid Grid.Row="2"
                              x:Name="dgProdutos"
                              Style="{StaticResource ModernDataGrid}"
                              SelectionChanged="DgProdutos_SelectionChanged">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Código" Binding="{Binding Codigo}" Width="70"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*" MinWidth="180"/>
                            <DataGridTextColumn Header="Categoria" Binding="{Binding Categoria}" Width="110"/>
                            <DataGridTextColumn Header="Unid." Binding="{Binding Unidade}" Width="60"/>
                            <DataGridTextColumn Header="Preço Custo" Binding="{Binding PrecoCusto, StringFormat=C2}" Width="100"/>
                            <DataGridTextColumn Header="Preço Venda" Binding="{Binding PrecoVenda, StringFormat=C2}" Width="100"/>
                            <DataGridTextColumn Header="Estoque" Binding="{Binding Estoque}" Width="75"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70"/>
                        </DataGrid.Columns>
                        <DataGrid.RowStyle>
                            <Style TargetType="DataGridRow">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Status}" Value="Inativo">
                                        <Setter Property="Foreground" Value="#999999"/>
                                        <Setter Property="FontStyle" Value="Italic"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.RowStyle>
                    </DataGrid>

                    <!-- Rodapé com ações -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   x:Name="txtTotalProdutos"
                                   Text="Total: 0 produto(s)"
                                   VerticalAlignment="Center"
                                   FontSize="12"
                                   Foreground="#666666"/>

                        <StackPanel Grid.Column="2" 
                                   Orientation="Horizontal" 
                                   HorizontalAlignment="Right">
                            <Button x:Name="btnEditar"
                                    Content="✏ Editar"
                                    Style="{StaticResource WarningButton}"
                                    Click="BtnEditar_Click"
                                    IsEnabled="False"/>

                            <Button x:Name="btnExcluir"
                                    Content="🗑 Excluir"
                                    Style="{StaticResource DangerButton}"
                                    Click="BtnExcluir_Click"
                                    IsEnabled="False"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>