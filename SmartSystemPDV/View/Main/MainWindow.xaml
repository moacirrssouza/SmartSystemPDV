<Window x:Class="SystemSmartPDV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemSmartPDV"
        mc:Ignorable="d"
        Title="Smart System PDV - Sistema Principal" 
        Height="600" 
        Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0">
                    <TextBlock Text="📊 Smart System PDV Adega" 
                               FontSize="24" 
                               FontWeight="Bold" 
                               Foreground="White"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="business solution" 
                               FontSize="12" 
                               Foreground="#CCCCCC"
                               VerticalAlignment="Bottom"
                               Margin="10,0,0,8"/>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center"
                           Margin="20,0">
                    <TextBlock x:Name="txtUsuarioLogado"
                               Text="Usuário: sa"
                               Foreground="White"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Margin="0,0,20,0"/>
                    <Button Content="Sair" 
                            Click="BtnSair_Click"
                            Background="#C87D3C"
                            Foreground="White"
                            BorderThickness="0"
                            Padding="15,5"
                            FontWeight="Bold"
                            Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" 
                                                    CornerRadius="5"
                                                    Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" 
                                                                VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#D68E4D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <Grid Grid.Row="1" Background="#F5F5F5">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="🎉 Bem-vindo ao Smart System PDV Adega!" 
                           FontSize="32" 
                           FontWeight="Bold"
                           Foreground="#1A4D7A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,20"/>

                <TextBlock Text="Login realizado com sucesso!" 
                           FontSize="18" 
                           Foreground="#666666"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,40"/>

                <!-- Cards de exemplo -->
                <WrapPanel HorizontalAlignment="Center" Margin="0,20">
                    <Border Width="200" Height="150" 
                            Background="White" 
                            Margin="10"
                            CornerRadius="10"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown_Vendas"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                            ShadowDepth="2" 
                                            Opacity="0.3"/>
                        </Border.Effect>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📈" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Vendas" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Gerenciar vendas" FontSize="12" Foreground="#666666" HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Border>

                    <Border Width="200" Height="150" 
                            Background="White" 
                            Margin="10"
                            CornerRadius="10"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                            ShadowDepth="2" 
                                            Opacity="0.3"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F8FF"/>
                                        <Setter Property="BorderBrush" Value="#1A4D7A"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📦" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Produtos" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Cadastro de produtos" FontSize="12" Foreground="#666666" HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Border>

                    <Border Width="200" Height="150" 
                            Background="White" 
                            Margin="10"
                            CornerRadius="10"
                            BorderBrush="#DDDDDD"
                            BorderThickness="1"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown_Estoque"
                            Cursor="Hand">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10" 
                                            ShadowDepth="2" 
                                            Opacity="0.3"/>
                        </Border.Effect>
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F8FF"/>
                                        <Setter Property="BorderBrush" Value="#1A4D7A"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="📊" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Estoque" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Controle de estoque" FontSize="12" Foreground="#666666" HorizontalAlignment="Center" Margin="0,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Usuários -->
                    <Border Width="200" Height="150"
            Background="White"
            Margin="10"
            CornerRadius="10"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            Cursor="Hand"
            MouseLeftButtonDown="Border_MouseLeftButtonDown_Usuarios">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="2"
                              Opacity="0.3"/>
                        </Border.Effect>

                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F8FF"/>
                                        <Setter Property="BorderBrush" Value="#1A4D7A"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="👤" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Usuários" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Gerenciar usuários"
                       FontSize="12"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,5"/>
                        </StackPanel>
                    </Border>

                    <!-- Permissões -->
                    <Border Width="200" Height="150"
            Background="White"
            Margin="10"
            CornerRadius="10"
            BorderBrush="#DDDDDD"
            BorderThickness="1"
            Cursor="Hand"
            MouseLeftButtonDown="Border_MouseLeftButtonDown_Permissoes">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="10"
                              ShadowDepth="2"
                              Opacity="0.3"/>
                        </Border.Effect>

                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#F0F8FF"/>
                                        <Setter Property="BorderBrush" Value="#1A4D7A"/>
                                        <Setter Property="BorderThickness" Value="2"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>

                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="🔐" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Permissões" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center"/>
                            <TextBlock Text="Controle de acessos"
                       FontSize="12"
                       Foreground="#666666"
                       HorizontalAlignment="Center"
                       Margin="0,5"/>
                        </StackPanel>
                    </Border>


                </WrapPanel>
            </StackPanel>
        </Grid>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="#1A4D7A">
            <TextBlock Text="© 2025 DataPlace - Business Solution | Todos os direitos reservados"
                       Foreground="White"
                       FontSize="11"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
        </Border>
    </Grid>
</Window>