<Window x:Class="SystemSmartPDV.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SystemSmartPDV"
        mc:Ignorable="d"
        Title="Smart System PDV - Sistema Principal" 
        Height="750" 
        Width="1400"
        MinHeight="650"
        MinWidth="1200"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Window.Resources>
        <!-- Estilo para Cards do Menu -->
        <Style x:Key="MenuCardStyle" TargetType="Border">
            <Setter Property="Width" Value="220"/>
            <Setter Property="Height" Value="180"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Margin" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.15" Color="#000000"/>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8FCFF"/>
                    <Setter Property="BorderBrush" Value="#1A4D7A"/>
                    <Setter Property="BorderThickness" Value="2"/>
                    <Setter Property="Effect">
                        <Setter.Value>
                            <DropShadowEffect BlurRadius="16" ShadowDepth="3" Opacity="0.25" Color="#1A4D7A"/>
                        </Setter.Value>
                    </Setter>
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Estilo para ícones dos cards -->
        <Style x:Key="CardIconStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="56"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,12"/>
            <Setter Property="Foreground" Value="#1A4D7A"/>
        </Style>

        <!-- Estilo para títulos dos cards -->
        <Style x:Key="CardTitleStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="#1A4D7A"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,0,6"/>
        </Style>

        <!-- Estilo para descrições dos cards -->
        <Style x:Key="CardDescriptionStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Foreground" Value="#666666"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>

        <!-- Estilo para botão Sair -->
        <Style x:Key="ExitButton" TargetType="Button">
            <Setter Property="Background" Value="#DC3545"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Padding" Value="20,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" 
                                CornerRadius="4"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" 
                                            VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C82333"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="#F5F7FA">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="40"/>
        </Grid.RowDefinitions>

        <!-- Cabeçalho -->
        <Border Grid.Row="0" Background="#1A4D7A">
            <Border.Effect>
                <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.2" Color="#000000"/>
            </Border.Effect>

            <Grid Margin="30,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🏪" 
                               FontSize="32" 
                               VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="Smart System PDV" 
                                   FontSize="24" 
                                   FontWeight="Bold" 
                                   Foreground="White"/>
                        <TextBlock Text="business solution" 
                                   FontSize="11" 
                                   Foreground="#B8D4E8"
                                   Margin="0,2,0,0"
                                   FontStyle="Italic"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" 
                           HorizontalAlignment="Right" 
                           VerticalAlignment="Center">
                    <Border Background="#2A5D8A"
                            CornerRadius="4"
                            Padding="12,6"
                            Margin="0,0,16,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="👤" 
                                       FontSize="16"
                                       VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock x:Name="txtUsuarioLogado"
                                       Text="Usuário: sa"
                                       Foreground="White"
                                       FontSize="13"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>

                    <Button Content="🚪 Sair" 
                            Click="BtnSair_Click"
                            Style="{StaticResource ExitButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Conteúdo Principal -->
        <ScrollViewer Grid.Row="1" 
                     VerticalScrollBarVisibility="Auto"
                     HorizontalScrollBarVisibility="Disabled">
            <StackPanel VerticalAlignment="Center" 
                       HorizontalAlignment="Center"
                       Margin="40">

                <!-- Título de Boas-vindas -->
                <StackPanel HorizontalAlignment="Center" Margin="0,0,0,40">
                    <TextBlock Text="Bem-vindo ao Smart System PDV!" 
                               FontSize="36" 
                               FontWeight="Bold"
                               Foreground="#1A4D7A"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,8"/>

                    <TextBlock Text="✓ Login realizado com sucesso" 
                               FontSize="16" 
                               Foreground="#28A745"
                               HorizontalAlignment="Center"
                               FontWeight="SemiBold"/>

                    <Rectangle Height="3" 
                              Width="120"
                              Fill="#1A4D7A"
                              Margin="0,16,0,0"
                              HorizontalAlignment="Center"
                              RadiusX="2"
                              RadiusY="2"/>
                </StackPanel>

                <!-- Seção de Módulos Principais -->
                <TextBlock Text="📋 Módulos do Sistema" 
                           FontSize="20" 
                           FontWeight="Bold"
                           Foreground="#1A4D7A"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,24"/>

                <!-- Cards de Menu -->
                <WrapPanel HorizontalAlignment="Center" 
                          Margin="0,0,0,20">

                    <!-- Card Vendas -->
                    <Border Style="{StaticResource MenuCardStyle}"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown_Vendas">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="💰" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Vendas" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Gerenciar vendas e" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="processar transações" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Produtos -->
                    <Border Style="{StaticResource MenuCardStyle}"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📦" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Produtos" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Cadastro e gestão" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="de produtos" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Estoque -->
                    <Border Style="{StaticResource MenuCardStyle}"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown_Estoque">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📊" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Estoque" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Controle de estoque e" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="movimentações" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Usuários -->
                    <Border Style="{StaticResource MenuCardStyle}"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown_Usuarios">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="👥" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Usuários" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Gerenciamento de" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="usuários do sistema" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Permissões -->
                    <Border Style="{StaticResource MenuCardStyle}"
                            MouseLeftButtonDown="Border_MouseLeftButtonDown_Permissoes">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🔐" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Permissões" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Controle de acessos" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="e permissões" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Relatórios (novo) -->
                    <Border Style="{StaticResource MenuCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="📈" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Relatórios" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Análises e relatórios" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="gerenciais" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Clientes (novo) -->
                    <Border Style="{StaticResource MenuCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="👨‍💼" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Clientes" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Cadastro e gestão" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="de clientes" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Fornecedores (novo) -->
                    <Border Style="{StaticResource MenuCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="🏭" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Fornecedores" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Gestão de" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="fornecedores" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card Configurações (novo) -->
                    <Border Style="{StaticResource MenuCardStyle}">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="⚙️" Style="{StaticResource CardIconStyle}"/>
                            <TextBlock Text="Configurações" Style="{StaticResource CardTitleStyle}"/>
                            <TextBlock Text="Configurações do" Style="{StaticResource CardDescriptionStyle}"/>
                            <TextBlock Text="sistema" Style="{StaticResource CardDescriptionStyle}"/>
                        </StackPanel>
                    </Border>

                </WrapPanel>

                <!-- Informações adicionais -->
                <Border Background="White"
                        CornerRadius="8"
                        Padding="20,16"
                        Margin="0,24,0,0"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"
                        MaxWidth="900">
                    <Border.Effect>
                        <DropShadowEffect BlurRadius="8" ShadowDepth="1" Opacity="0.1"/>
                    </Border.Effect>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Info 1 -->
                        <StackPanel Grid.Column="0" 
                                   HorizontalAlignment="Center"
                                   Orientation="Horizontal">
                            <TextBlock Text="📅" 
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Data do Sistema"
                                          FontSize="11"
                                          Foreground="#666666"/>
                                <TextBlock x:Name="txtDataSistema"
                                          Text="29/12/2025"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#1A4D7A"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Info 2 -->
                        <StackPanel Grid.Column="1" 
                                   HorizontalAlignment="Center"
                                   Orientation="Horizontal">
                            <TextBlock Text="🕐" 
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"/>
                            <StackPanel>
                                <TextBlock Text="Horário"
                                          FontSize="11"
                                          Foreground="#666666"/>
                                <TextBlock x:Name="txtHorarioSistema"
                                          Text="14:30:00"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#1A4D7A"/>
                            </StackPanel>
                        </StackPanel>

                        <!-- Info 3 -->
                        <StackPanel Grid.Column="2" 
                                   HorizontalAlignment="Center"
                                   Orientation="Horizontal">
                            <TextBlock Text="✓" 
                                       FontSize="24"
                                       VerticalAlignment="Center"
                                       Margin="0,0,10,0"
                                       Foreground="#28A745"/>
                            <StackPanel>
                                <TextBlock Text="Status"
                                          FontSize="11"
                                          Foreground="#666666"/>
                                <TextBlock Text="Sistema Online"
                                          FontSize="14"
                                          FontWeight="SemiBold"
                                          Foreground="#28A745"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Rodapé -->
        <Border Grid.Row="2" Background="#1A4D7A">
            <Grid Margin="30,0">
                <TextBlock Text="© 2026 Smart System PDV Adega - Business Solution"
                           Foreground="White"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Left"/>

                <TextBlock Text="Versão 1.0.0 | Todos os direitos reservados"
                           Foreground="#B8D4E8"
                           FontSize="11"
                           VerticalAlignment="Center"
                           HorizontalAlignment="Right"/>
            </Grid>
        </Border>
    </Grid>
</Window>